function Funcs:StopFlight()
	Flight.active = false

	if Connections.Flight then
		Connections.Flight:Disconnect()
		Connections.Flight = nil
	end

	if Flight.bg then Flight.bg:Destroy() Flight.bg = nil end
	if Flight.bv then Flight.bv:Destroy() Flight.bv = nil end

	if Humanoid and Humanoid.Parent then
		Humanoid.PlatformStand = false
	end

	if Flight.button then
		Flight.button.BackgroundColor3 = Color3.fromRGB(110, 50, 190)
	end
end

function Funcs:StartFlight()
	if Flight.active then return end

	Character = LocalPlayer.Character
	local Root = Character and Character:FindFirstChild("HumanoidRootPart")
	Humanoid = Character and Character:FindFirstChild("Humanoid")
	if not Root or not Humanoid then return end

	Flight.active = true

	local bg = Instance.new("BodyGyro")
	bg.P = 9e4
	bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	bg.CFrame = Root.CFrame
	bg.Parent = Root

	local bv = Instance.new("BodyVelocity")
	bv.Velocity = Vector3.zero
	bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	bv.Parent = Root

	Flight.bg, Flight.bv = bg, bv

	if Flight.button then
		Flight.button.BackgroundColor3 = Color3.fromRGB(170, 90, 255)
	end

	Connections.Flight = RunService.RenderStepped:Connect(function()
		if not Humanoid or not Humanoid.Parent or Humanoid.Health <= 0 or not Root.Parent then
			Funcs:StopFlight()
			return
		end

		Camera = workspace.CurrentCamera
		Humanoid.PlatformStand = true

		local c = Flight.ctrl
		local Forward, Right = c.f + c.b, c.l + c.r

		-- No keys held (mobile thumbstick / gamepad): use the humanoid's move direction
		if Forward == 0 and Right == 0 then
			local Rel = Camera.CFrame:VectorToObjectSpace(Humanoid.MoveDirection)
			Forward, Right = -Rel.Z, Rel.X
		end

		local Dir = Camera.CFrame.LookVector * Forward
			+ Camera.CFrame.RightVector * Right

		bv.Velocity = Dir.Magnitude > 0 and Dir.Unit * Config.flightSpeed or Vector3.zero
		bg.CFrame = Camera.CFrame
	end)
end

function Funcs:ToggleFlight()
	if Flight.active then
		Funcs:StopFlight()
	else
		Funcs:StartFlight()
	end
end

function Funcs:FlightEnabled(Value)
	Config.flightEnabled = Value
	if not Value then
		Funcs:StopFlight()
	end
end

