function Funcs:JumpPower(Value)
	if not Humanoid or not Humanoid.Parent then
		Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		Humanoid = Character:WaitForChild("Humanoid")
	end
	if not Humanoid.UseJumpPower then
		Humanoid.UseJumpPower = true
	end
	Humanoid.JumpPower = Value
end


function Funcs:ZoomDistance(Value)
	LocalPlayer.CameraMaxZoomDistance = Value
end


function Funcs:FOV(Value)
	Camera = workspace.CurrentCamera
	if Camera then
		Camera.FieldOfView = Value
	end
end


local DefaultFog = {
	FogEnd = Lighting.FogEnd,
	FogStart = Lighting.FogStart,
}


function Funcs:ClearFog(Value)
	if Value then
		Lighting.FogEnd = 1000000
		Lighting.FogStart = 1000000
	else
		Lighting.FogEnd = DefaultFog.FogEnd
		Lighting.FogStart = DefaultFog.FogStart
	end
end


function Funcs:GlobalShadows(Value)
	Lighting.GlobalShadows = Value
end


-- MARK: Flight Funcs
--

function Funcs:StopFlight()
	Flight.active = false

	if Connections.Flight then
		Connections.Flight:Disconnect()
		Connections.Flight = nil
	end

	if Flight.bg then Flight.bg:Destroy() Flight.bg = nil end
	if Flight.bv then Flight.bv:Destroy() Flight.bv = nil end

	if Humanoid and Humanoid.Parent then
		Humanoid.PlatformStand = false
	end
end

function Funcs:StartFlight()
	if Flight.active then return end

	Character = LocalPlayer.Character
	local Root = Character and Character:FindFirstChild("HumanoidRootPart")
	Humanoid = Character and Character:FindFirstChild("Humanoid")
	if not Root or not Humanoid then return end

	Flight.active = true

	local bg = Instance.new("BodyGyro")
	bg.P = 9e4
	bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	bg.CFrame = Root.CFrame
	bg.Parent = Root

	local bv = Instance.new("BodyVelocity")
	bv.Velocity = Vector3.zero
	bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	bv.Parent = Root

	Flight.bg, Flight.bv = bg, bv

	Connections.Flight = RunService.RenderStepped:Connect(function()
		if not Humanoid or not Humanoid.Parent or Humanoid.Health <= 0 or not Root.Parent then
			Funcs:StopFlight()
			return
		end

		Camera = workspace.CurrentCamera
		Humanoid.PlatformStand = true

		local c = Flight.ctrl
		local Dir = Camera.CFrame.LookVector * (c.f + c.b)
			+ Camera.CFrame.RightVector * (c.l + c.r)

		bv.Velocity = Dir.Magnitude > 0 and Dir.Unit * Config.flightSpeed or Vector3.zero
		bg.CFrame = Camera.CFrame
	end)
end

function Funcs:ToggleFlight()
	if Flight.active then
		Funcs:StopFlight()
	else
		Funcs:StartFlight()
	end
end

function Funcs:FlightEnabled(Value)
	Config.flightEnabled = Value
	if not Value then
		Funcs:StopFlight()
	end
end

local MoveKeys = {
	[Enum.KeyCode.W] = { "f", 1 },
	[Enum.KeyCode.S] = { "b", -1 },
	[Enum.KeyCode.A] = { "l", -1 },
	[Enum.KeyCode.D] = { "r", 1 },
}

UserInputService.InputBegan:Connect(function(Input, Processed)
	if Processed then return end

	if Input.KeyCode == Config.flightKey and Config.flightEnabled then
		Funcs:ToggleFlight()
		return
	end

	local Move = MoveKeys[Input.KeyCode]
	if Move then
		Flight.ctrl[Move[1]] = Move[2]
	end
end)

UserInputService.InputEnded:Connect(function(Input)
	local Move = MoveKeys[Input.KeyCode]
	if Move then
		Flight.ctrl[Move[1]] = 0
	end
end)


-- Character / Misc Connections
--
LocalPlayer.CharacterAdded:Connect(function(Value)
	Funcs:StopFlight()
	Flight.ctrl = { f = 0, b = 0, l = 0, r = 0 }

	Character = Value
	Humanoid = Value:WaitForChild("Humanoid")
	Humanoid.WalkSpeed = Config.walkSpeed
	Humanoid.JumpPower = Config.jumpPower
end)

UserInputService.JumpRequest:Connect(function()
	if Config.infiniteJump and Humanoid and Humanoid.Parent then
		Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	Camera = workspace.CurrentCamera
	if Camera then
		Camera.FieldOfView = Config.FOV
	end
end)


