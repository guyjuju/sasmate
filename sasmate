local TimeTargets = {
	day   = 14, -- 2 PM
	night = 0,  -- midnight
}

local DefaultClock = Lighting.ClockTime

-- Sets the time of day and keeps it there until the mode is cleared
function Funcs:SetTimeMode(Mode)
	Config.timeMode = Mode

	if Connections.TimeLock then
		Connections.TimeLock:Disconnect()
		Connections.TimeLock = nil
	end

	local Target = Mode and TimeTargets[Mode]
	if not Target then
		Lighting.ClockTime = DefaultClock
		return
	end

	Lighting.ClockTime = Target

	-- If the game tries to move the clock, put it back
	Connections.TimeLock = Lighting:GetPropertyChangedSignal("ClockTime"):Connect(function()
		if Config.timeMode and Lighting.ClockTime ~= TimeTargets[Config.timeMode] then
			Lighting.ClockTime = TimeTargets[Config.timeMode]
		end
	end)
end


