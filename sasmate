local DefaultFog = {
	FogEnd = Lighting.FogEnd,
	FogColor = Lighting.FogColor,
	OutdoorAmbient = Lighting.OutdoorAmbient,
}

local SavedTints = {}

function Funcs:ClearFog(Value)
	if Value then
		Lighting.FogEnd = 100000
		Lighting.FogColor = Color3.fromRGB(255, 255, 255)
		Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
		local Correction = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
		if Correction then
			if SavedTints[Correction] == nil then
				SavedTints[Correction] = Correction.TintColor
			end
			Correction.TintColor = Color3.fromRGB(255, 255, 255)
		end
	else
		Lighting.FogEnd = DefaultFog.FogEnd
		Lighting.FogColor = DefaultFog.FogColor
		Lighting.OutdoorAmbient = DefaultFog.OutdoorAmbient
		for Correction, Tint in pairs(SavedTints) do
			if Correction.Parent then
				Correction.TintColor = Tint
			end
			SavedTints[Correction] = nil
		end
	end
end


