local ItemState = {
	stacking   = false,
	abort      = false,
	iteration  = 25,
	x          = 1,
	y          = 0, -- 0 = as tall as needed
	z          = 1,
	sawmilling = false,
}

local function Disconnect(Key)
	if Connections[Key] then
		Connections[Key]:Disconnect()
		Connections[Key] = nil
	end
end

-- The model of yours (in PlayerModels) that is under the mouse, or nil
local function ClickedOwnModel()
	local Models = workspace:FindFirstChild("PlayerModels")
	local Target = LocalPlayer:GetMouse().Target
	if not Models or not Target then return nil end

	local Model = Target
	while Model and Model.Parent ~= Models do
		Model = Model.Parent
	end
	if not Model then return nil end

	local Owner = Model:FindFirstChild("Owner")
	if Owner and Owner.Value == LocalPlayer then
		return Model
	end
	return nil
end

-- What kind of item a model is: the name of its identifying value and the value
local function ItemKind(Model)
	for _, Key in ipairs({ "ItemName", "PurchasedBoxItemName", "TreeClass" }) do
		local Value = Model:FindFirstChild(Key)
		if Value then
			return Key, Value.Value
		end
	end
	return nil
end

-- Every item of yours with the same kind as this one
local function GetSameItems(Key, Value, AnyPart)
	local List = {}
	local Models = workspace:FindFirstChild("PlayerModels")
	if not Models then return List end

	for _, Model in ipairs(Models:GetChildren()) do
		local Owner = Model:FindFirstChild("Owner")
		local Kind = Model:FindFirstChild(Key)
		if Owner and Owner.Value == LocalPlayer and Kind and Kind.Value == Value and (AnyPart or Model:FindFirstChild("Main")) then
			table.insert(List, Model)
		end
	end
	return List
end


