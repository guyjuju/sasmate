function Funcs:BuyBox(BoxName, OpenBox, Home)
	local Counter = Funcs:GetStoreCounter()
	if not Counter then
		return false, "no counter nearby"
	end

	local Npc = Funcs:GetStoreNpc(Counter)
	if not Npc then
		return false, "Couldn't find the store clerk"
	end

	local StoreId = CashierIds[Npc.Name]
	if not StoreId then
		AskForCashierId(Npc)
		StoreId = CashierIds[Npc.Name]
	end

	local Root = GetRoot()
	if Root and (Root.Position - Counter.Position).Magnitude > 12 then
		Funcs:TeleportTo(CFrame.new(Counter.Position + Vector3.new(5, 3, 5)))
		task.wait(0.2)
	end

	local Guessing = (StoreId == nil)
	local Candidates, Guess, LastTry, DialogId = {}, 0, nil, StoreId
	if Guessing then
		local Taken = {}
		for _, Known in pairs(CashierIds) do
			Taken[Known] = true
		end
		for Id = 1, CashierTimeouts.guessIds do
			if not Taken[Id] then
				table.insert(Candidates, Id)
			end
		end
	else
		Funcs:TalkToNpc(StoreId, Npc, "Initiate")
		task.wait(0.5)
	end

	local Box, Main, Bought, Reason = nil, nil, false, nil
	for _ = 1, 3 do
		if Buy.abort then break end
		Box = Funcs:FindShopBox(BoxName, 5)
		if not Box then
			Reason = "not on the shelf"
		else
			Main = Box:FindFirstChild("Main")
			Root = GetRoot()
			if Main and Root then
				if (Root.Position - Main.Position).Magnitude > 25 then
					Funcs:TeleportTo(CFrame.new(Main.Position + Vector3.new(5, 1, 5)))
					task.wait(0.2)
				end
				local Owned, Why = AcquireNetworkOwnership(Box, { Main }, 6)
				if not Owned then
					Reason = Why
				else
					local Spot = Counter.CFrame + Vector3.new(0, Counter.Size.Y / 2 + Main.Size.Y / 2 + 0.5, 0)
					for _ = 1, 25 do
						Drag(Box)
						Box:PivotTo(Spot)
						task.wait()
					end
					if (Main.Position - Spot.Position).Magnitude > 8 then
						Reason = "couldn't place it on the counter"
					else
						local Started = os.clock()
						local Budget = Guessing and CashierTimeouts.guessTimeout or CashierTimeouts.checkoutTimeout
						while not Buy.abort and Box.Parent and Box.Parent.Name == "ShopItems" and os.clock() - Started < Budget do
							Drag(Box)
							if Guessing then
								Guess = Guess + 1
								LastTry = Candidates[Guess]
								if not LastTry then break end
								DialogId = LastTry
							end
							Funcs:TalkToNpc(DialogId, Npc, "ConfirmPurchase")
							task.wait(Guessing and 0.2 or 0.1)
						end
						if not Box.Parent or Box.Parent.Name ~= "ShopItems" then
							Bought = true
							Reason = nil
							if Guessing and LastTry then
								CashierIds[Npc.Name] = LastTry
								SaveCashierIds()
							end
						else
							Reason = "checkout timed out"
						end
					end
				end
			else
				Reason = "your character isn't loaded"
			end
		end
		if Bought or Buy.abort then break end
		task.wait(1.5)
	end

	if Buy.abort then return false, "it was stopped" end
	if not Bought then return false, Reason or "checkout timed out" end
	if OpenBox then
		local Opened = os.clock()
		while Box.Parent and not Buy.abort and os.clock() - Opened < 10 do
			ReplicatedStorage.Interaction.ClientInteracted:FireServer(Box, "Open box")
			task.wait(1)
		end
	else
		for _ = 1, 25 do
			Drag(Box)
			Box:PivotTo(Home + Vector3.new(5, 1, 0))
			task.wait()
		end
	end

	return true
end

function Funcs:AutoBuy(Label, Amount)
	if type(Label) == "table" then Label = Label[1] end

	if Buy.running then
		Funcs:Notify("Money", "Auto Buy is already running")
		return
	end

	local Entry = Label and Buy.items[Label]
	if not Entry then
		Funcs:Notify("Picking", "Pick at least one item first")
		return
	end

	local Total, Have = Entry.Price * Amount, GetMoney()
	if Have < Total then
		Funcs:Notify("Sas Mate", "That costs $" .. Total .. " and you have $" .. Have)
		return
	end

	local Root = GetRoot()
	if not Root then
		Funcs:Notify("Auto Buy couldn't start", "Auto Buy couldn't start: your character isn't loaded")
		return
	end

	Buy.running, Buy.abort = true, false
	local Home = Root.CFrame

	task.spawn(function()
		local Done, Failure = 0, nil

		for _ = 1, Amount do
			if Buy.abort then break end

			local Ok, Success, Msg = pcall(Funcs.BuyBox, Funcs, Entry.Box, false, Home)
			if not Ok then
				Success, Msg = false, tostring(Success)
			end

			if not Success then
				Failure = Msg
				break
			end

			Done = Done + 1
			task.wait(0.3)
		end

		local Aborted = Buy.abort
		Buy.running = false
		Funcs:TeleportTo(Home)

		if Aborted then
			Funcs:Notify("Sas Mate", "Bought " .. Done .. "/" .. Amount .. " " .. Label .. ": it was stopped")
		elseif Failure then
			Funcs:Notify("Sas Mate", "Bought " .. Done .. "/" .. Amount .. " " .. Label .. ": " .. Failure)
		else
			Funcs:Notify("Sas Mate", "Bought " .. Done .. " " .. Label)
		end
	end)
end

function Funcs:AbortBuying()
	if Buy.running then
		Buy.abort = true
	else
		Funcs:Notify("Sas Mate", "Nothing to stop")
	end
end

function Funcs:PurchaseAllBlueprints()
	if Buy.running then
		Funcs:Notify("Money", "Auto Buy is already running")
		return
	end

	local Info = ReplicatedStorage:FindFirstChild("ClientItemInfo")
	local Folder = LocalPlayer:FindFirstChild("PlayerBlueprints")
	local Owned = Folder and Folder:FindFirstChild("Blueprints")
	if not Info or not Owned then
		Funcs:Notify("Blueprints", "Couldn't read your blueprint data.")
		return
	end

	local ToBuy, Cost = {}, 0
	for _, Item in ipairs(Info:GetChildren()) do
		local Type = Item:FindFirstChild("Type")
		local Price = Item:FindFirstChild("Price")
		if Type and Price and (Type.Value == "Structure" or Type.Value == "Furniture")
			and Item:FindFirstChild("WoodCost") and not Owned:FindFirstChild(Item.Name) then
			table.insert(ToBuy, Item.Name)
			Cost = Cost + Price.Value
		end
	end

	if #ToBuy == 0 then
		Funcs:Notify("Building", "You already own every blueprint")
		return
	end

	local Money = GetMoney()
	if Money < Cost then
		Funcs:Notify("Building", "You need $" .. (Cost - Money) .. " more to buy every blueprint")
		return
	end

	local Root = GetRoot()
	if not Root then
		Funcs:Notify("Auto Buy couldn't start", "Auto Buy couldn't start: your character isn't loaded")
		return
	end

	Buy.running, Buy.abort = true, false
	local Home = Root.CFrame

	task.spawn(function()
		local Done, Unsold, Failure = 0, {}, nil

		for _, Name in ipairs(ToBuy) do
			if Buy.abort then break end

			local Ok, Success, Msg = pcall(Funcs.BuyBox, Funcs, Name, true, Home)
			if not Ok then
				Success, Msg = false, tostring(Success)
			end

			if Success then
				Done = Done + 1
			elseif Msg == "not on the shelf" then
				table.insert(Unsold, Name)
			else
				Failure = Msg
				break
			end
			task.wait()
		end

		local Aborted = Buy.abort
		Buy.running = false
		Funcs:TeleportTo(Home)

		if Aborted then return end
		if Done == #ToBuy and #Unsold == 0 then
			Funcs:Notify("Building", "Bought every blueprint")
			return
		end
		local Parts = { "Bought " .. Done .. " of " .. #ToBuy .. " blueprints." }
		if #Unsold > 0 then
			local Names = {}
			for _, Name in ipairs(Unsold) do
				local Item = Info:FindFirstChild(Name)
				local Label = Item and Item:FindFirstChild("ItemName")
				table.insert(Names, Label and Label.Value or Name)
			end
			table.insert(Parts, "Not sold in any shop yet: " .. table.concat(Names, ", "))
		end
		if Failure then
			table.insert(Parts, "Missed: " .. Failure)
		end
		Funcs:Notify("Building", table.concat(Parts, " "))
	end)
end

