function Funcs:StopFlight()
	Flight.active = false

	if Connections.Flight then
		Connections.Flight:Disconnect()
		Connections.Flight = nil
	end

	if Flight.bg then Flight.bg:Destroy() Flight.bg = nil end
	if Flight.bv then Flight.bv:Destroy() Flight.bv = nil end

	if Humanoid and Humanoid.Parent then
		Humanoid.PlatformStand = false
	end

	if Flight.button then
		Flight.button.BackgroundColor3 = Color3.fromRGB(110, 50, 190)
	end
end

function Funcs:StartFlight()
	if Flight.active then return end

	Character = LocalPlayer.Character
	local Root = Character and Character:FindFirstChild("HumanoidRootPart")
	Humanoid = Character and Character:FindFirstChild("Humanoid")
	if not Root or not Humanoid then return end

	Flight.active = true

	local bg = Instance.new("BodyGyro")
	bg.P = 9e4
	bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	bg.CFrame = Root.CFrame
	bg.Parent = Root

	local bv = Instance.new("BodyVelocity")
	bv.Velocity = Vector3.zero
	bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	bv.Parent = Root

	Flight.bg, Flight.bv = bg, bv

	if Flight.button then
		Flight.button.BackgroundColor3 = Color3.fromRGB(170, 90, 255)
	end

	Connections.Flight = RunService.RenderStepped:Connect(function()
		if not Humanoid or not Humanoid.Parent or Humanoid.Health <= 0 or not Root.Parent then
			Funcs:StopFlight()
			return
		end

		Camera = workspace.CurrentCamera
		Humanoid.PlatformStand = true

		local c = Flight.ctrl
		local Forward, Right = c.f + c.b, c.l + c.r

		-- No keys held (mobile thumbstick / gamepad): use the humanoid's move direction
		if Forward == 0 and Right == 0 then
			local Rel = Camera.CFrame:VectorToObjectSpace(Humanoid.MoveDirection)
			Forward, Right = -Rel.Z, Rel.X
		end

		local Dir = Camera.CFrame.LookVector * Forward
			+ Camera.CFrame.RightVector * Right

		bv.Velocity = Dir.Magnitude > 0 and Dir.Unit * Config.flightSpeed or Vector3.zero
		bg.CFrame = Camera.CFrame
	end)
end

function Funcs:ToggleFlight()
	if Flight.active then
		Funcs:StopFlight()
	else
		Funcs:StartFlight()
	end
end

function Funcs:FlightEnabled(Value)
	Config.flightEnabled = Value
	if not Value then
		Funcs:StopFlight()
	end
end

-- On-screen draggable fly button for mobile
function Funcs:FlyButton(v)
	if not v then
		if Flight.gui then Flight.gui:Destroy() end
		for _, Conn in ipairs(Flight.btnConns or {}) do Conn:Disconnect() end
		Flight.gui, Flight.button, Flight.btnConns = nil, nil, nil
		return
	end

	if Flight.gui then return end

	local Gui = Instance.new("ScreenGui")
	Gui.Name = "SasMateFly"
	Gui.ResetOnSpawn = false
	Gui.Parent = (typeof(gethui) == "function" and gethui()) or game.CoreGui

	local Btn = Instance.new("TextButton")
	Btn.Name = "FlyButton"
	Btn.Parent = Gui
	Btn.AnchorPoint = Vector2.new(0.5, 0.5)
	Btn.Position = UDim2.new(1, -60, 0.6, 0)
	Btn.Size = UDim2.new(0, 42, 0, 42)
	Btn.BackgroundColor3 = Flight.active and Color3.fromRGB(170, 90, 255) or Color3.fromRGB(110, 50, 190)
	Btn.Text = "FLY"
	Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	Btn.Font = Enum.Font.GothamBold
	Btn.TextSize = 13
	Btn.AutoButtonColor = false

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 250)
	Corner.Parent = Btn

	local Stroke = Instance.new("UIStroke")
	Stroke.Color = Color3.fromRGB(60, 20, 110)
	Stroke.Thickness = 2
	Stroke.Parent = Btn

	Flight.gui, Flight.button = Gui, Btn

	local Dragging, Moved, DragStart, StartPos = false, false, nil, nil
	local Conns = {}
	Flight.btnConns = Conns

	table.insert(Conns, Btn.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseButton1 then
			Dragging, Moved = true, false
			DragStart, StartPos = Input.Position, Btn.Position
		end
	end))

	table.insert(Conns, UserInputService.InputChanged:Connect(function(Input)
		if Dragging and (Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseMovement) then
			local Delta = Input.Position - DragStart
			if Delta.Magnitude > 8 then Moved = true end
			if Moved then
				Btn.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + Delta.X, StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y)
			end
		end
	end))

	table.insert(Conns, UserInputService.InputEnded:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseButton1 then
			Dragging = false
		end
	end))

	table.insert(Conns, Btn.MouseButton1Click:Connect(function()
		if not Moved then
			Funcs:ToggleFlight()
		end
	end))
end

local MoveKeys = {
	[Enum.KeyCode.W] = { "f", 1 },
	[Enum.KeyCode.S] = { "b", -1 },
	[Enum.KeyCode.A] = { "l", -1 },
	[Enum.KeyCode.D] = { "r", 1 },
}

UserInputService.InputBegan:Connect(function(Input, Processed)
	if Processed then return end

	local Move = MoveKeys[Input.KeyCode]
	if Move then
		Flight.ctrl[Move[1]] = Move[2]
	end
end)

UserInputService.InputEnded:Connect(function(Input)
