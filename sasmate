local function GetMoney()
	local Funds = ReplicatedStorage:FindFirstChild("Transactions")
	local Remote = Funds and Funds:FindFirstChild("ClientToServer")
	local Getter = Remote and Remote:FindFirstChild("GetFunds")
	if Getter then
		local Ok, Value = pcall(function()
			return Getter:InvokeServer(LocalPlayer)
		end)
		if Ok and tonumber(Value) then
			return tonumber(Value)
		end
	end
	local Stats = LocalPlayer:FindFirstChild("leaderstats")
	local Money = Stats and Stats:FindFirstChild("Money")
	return Money and Money.Value or 0
end

