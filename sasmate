end

-- Flips the car you are driving back onto its wheels (and lifts it a little)
function Funcs:FlipVehicle()
	local _, Hum = GetRoot()
	local Seat = Hum and Hum.SeatPart

	if not Seat or Seat.Name ~= "DriveSeat" then
		Funcs:Notify("Vehicle", "Sit in the driver's seat of the car you want to flip.")
		return
	end

	local Car = Seat.Parent
	Car:PivotTo(Car:GetPivot() * CFrame.Angles(math.rad(180), 0, 0) + Vector3.new(0, 5, 0))
