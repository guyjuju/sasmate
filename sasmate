function Funcs:Brightness(Value)
	Lighting.Brightness = Value
end

local Graphics = { on = false, effects = {}, saved = {}, overlay = nil }

-- Nicer lighting: blur, sun rays and contrast, clear water and see-through leaves
function Funcs:BetterGraphics(Value)
	if Value == Graphics.on then return end
	Graphics.on = Value

	if Value then
		-- Switch off the game's own colour correction while ours is on
		Graphics.saved = {}
		for _, Child in ipairs(Lighting:GetChildren()) do
			if Child:IsA("ColorCorrectionEffect") then
				Graphics.saved[Child] = Child.Enabled
				Child.Enabled = false
			end
		end

		local function Make(Class, Props)
			local Effect = Instance.new(Class)
			for Key, Val in pairs(Props) do
				Effect[Key] = Val
			end
			Effect.Name = "SasMate" .. Class
			Effect.Parent = Lighting
			table.insert(Graphics.effects, Effect)
		end

		Make("BlurEffect", { Size = 3 })
		Make("ColorCorrectionEffect", { Brightness = 0.03, Contrast = 0.3, Saturation = 0.01, TintColor = Color3.fromRGB(244, 244, 244) })
		Make("SunRaysEffect", { Intensity = 0.2, Spread = 1 })

		local Overlay = LocalPlayer.PlayerGui:FindFirstChild("UnderwaterOverlay")
		if Overlay and Overlay:IsA("LayerCollector") then
			Graphics.overlay = Overlay
			Overlay.Enabled = false
		end
	else
		for _, Effect in ipairs(Graphics.effects) do
			Effect:Destroy()
		end
		Graphics.effects = {}

		for Child, Enabled in pairs(Graphics.saved) do
			if Child.Parent then
				Child.Enabled = Enabled
			end
		end
		Graphics.saved = {}

		if Graphics.overlay and Graphics.overlay.Parent then
			Graphics.overlay.Enabled = true
		end
		Graphics.overlay = nil
	end

	-- Water and leaves are all over the map, so do them in the background
	task.spawn(function()
		local Seen = 0
		for _, Obj in ipairs(workspace:GetDescendants()) do
			if Graphics.on ~= Value then return end -- toggled again, stop

			if Obj:IsA("Part") then
				if Obj.Name == "Water" then
					pcall(function()
						workspace.Terrain:FillBlock(Obj.CFrame, Obj.Size, Value and Enum.Material.Water or Enum.Material.Air)
					end)
					Obj.Transparency = (Value or MapState.water) and 1 or 0
				elseif Obj.Name == "LeafPart" then
					Obj.Transparency = Value and 0.5 or 0
				end
			end

			Seen = Seen + 1
			if Seen % 400 == 0 then
				task.wait()
			end
		end
	end)
end


-- MARK: Vehicle Funcs
--

local Vehicle = {
	speed     = nil, -- nil = leave the car's own setting alone
	steer     = nil,
	color     = nil,
	stopOnPink = false,
	spawning  = false,
	abort     = false,
}

local CarColors = {
	"Medium stone grey", "Sand green", "Sand red", "Faded green", "Dark grey metallic", "Dark grey",
	"Earth yellow", "Earth orange", "Silver", "Brick yellow", "Dark red", "Hot pink",
}

local function IsOwnVehicle(Model)
	local Type = Model:FindFirstChild("Type")
	local Owner = Model:FindFirstChild("Owner")
	return Type and Type.Value == "Vehicle" and Owner and Owner.Value == LocalPlayer
end

local function ApplyVehicleSettings(Model)
	local Config = Model:FindFirstChild("Configuration")
	if not Config then return end

	for Key, Value in pairs({ MaxSpeed = Vehicle.speed, SteerAngle = Vehicle.steer }) do
		local Setting = Config:FindFirstChild(Key)
		if Setting and Value then
			Setting.Value = Value
		end
	end
end

-- Sets MaxSpeed or SteerAngle on all your vehicles (and on any you spawn later)
function Funcs:SetVehicleSetting(Key, Value)
	if Key == "MaxSpeed" then
		Vehicle.speed = Value
	else
		Vehicle.steer = Value
	end

	local Models = workspace:FindFirstChild("PlayerModels")
	if not Models then return end

	for _, Model in ipairs(Models:GetChildren()) do
		if IsOwnVehicle(Model) then
			ApplyVehicleSettings(Model)
		end
	end
end

-- Applies your speed and steering to every new vehicle of yours
function Funcs:InstallVehicleHook()
	Disconnect("VehicleAdded")

	local Models = workspace:FindFirstChild("PlayerModels")
	if not Models then return end

