function Funcs:UIScale(Percent)
	local ScreenGui = game.CoreGui:FindFirstChild("SasMate")
	local Main = ScreenGui and ScreenGui:FindFirstChild("Main")
	if not Main then return end

	local Scale = Main:FindFirstChild("SasScale")
	if not Scale then
		Scale = Instance.new("UIScale")
		Scale.Name = "SasScale"
		Scale.Parent = Main
	end
	Scale.Scale = math.clamp(Percent, 30, 250) / 100
end

