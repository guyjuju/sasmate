-- Moves your planks/logs of the chosen wood (any size) into each of your placed blueprints
local Filling = false

function Funcs:FillBlueprints()
	if Filling then
		Funcs:Notify("Blueprints", "Already filling, wait for it to finish")
		return
	end

	local Models = workspace:FindFirstChild("PlayerModels")
	if not Models then return end
	local Root = GetRoot()
	if not Root then return end

	local Power = LocalPlayer:FindFirstChild("SuperBlueprint")
	if Power and Power.Value == false then
		Funcs:Notify("Blueprints", "You don't have the Super Blueprint power, this may not work")
	end

	local function IsMine(Model)
		local Owner = Model:FindFirstChild("Owner")
		return Owner and Owner.Value == LocalPlayer
	end

	local function Wood()
		local List = {}
		for _, Folder in ipairs({ Models, workspace:FindFirstChild("LogModels") }) do
			if Folder then
				for _, Model in ipairs(Folder:GetChildren()) do
					local Class = Model:FindFirstChild("TreeClass")
					if Class and Model:FindFirstChild("WoodSection") and IsMine(Model) then
						if Class.Value == FillWood then
							table.insert(List, Model)
						end
					end
				end
			end
		end
		return List
	end

	local function Blueprints()
		local List = {}
		for _, Model in ipairs(Models:GetChildren()) do
			local Type = Model:FindFirstChild("Type")
			if Type and Type.Value == "Blueprint" and Model:FindFirstChild("BuildDependentWood") and IsMine(Model) then
				table.insert(List, Model)
			end
		end
		return List
	end

	local Targets, Pieces = Blueprints(), Wood()
	if #Targets == 0 then
		Funcs:Notify("Blueprints", "You have no blueprints placed")
		return
	end
	if #Pieces == 0 then
		Funcs:Notify("Blueprints", "You have no " .. FillWood .. " wood")
		return
	end

	Filling = true
	local Home = Root.CFrame
	local Used = 0

	local Ok, Err = pcall(function()
		for Pass = 1, 3 do
			Targets = Blueprints()
			if #Targets == 0 then break end

			for _, Blueprint in ipairs(Targets) do
				local Piece = table.remove(Pieces, 1)
				if not Piece then break end
				if not Piece.Parent or not Blueprint.Parent then continue end

				local Section = Piece:FindFirstChild("WoodSection")
				local Slot = Blueprint:FindFirstChild("BuildDependentWood")
				if not Section or not Slot then continue end

				Piece.PrimaryPart = Section
				Funcs:TeleportTo(CFrame.new(Section.Position + Vector3.new(0, 3, 3)))
				task.wait()
				TakeControl(Piece, Section, 5)

				for _ = 1, 60 do
					if not Piece.Parent or not Blueprint.Parent then break end
					Drag(Piece)
					pcall(function() Piece:SetPrimaryPartCFrame(Slot.CFrame) end)
					Section.AssemblyLinearVelocity = Vector3.zero
					Section.AssemblyAngularVelocity = Vector3.zero
					task.wait()
				end
				Used = Used + 1
			end

			if #Pieces == 0 then break end
		end
	end)

	Funcs:TeleportTo(Home)
	Filling = false

	if not Ok then
		Funcs:Notify("Blueprints", "Stopped: " .. tostring(Err))
	else
		Funcs:Notify("Blueprints", "Moved " .. Used .. " pieces of " .. FillWood .. " into your blueprints")
	end
end

function Funcs:PurchaseAllBlueprints()
	if Buy.running then
		Funcs:Notify("Money", "Auto Buy is already running")
		return
	end

	local Info = ReplicatedStorage:FindFirstChild("ClientItemInfo")
	local Folder = LocalPlayer:FindFirstChild("PlayerBlueprints")
	local Owned = Folder and Folder:FindFirstChild("Blueprints")
	if not Info or not Owned then
		Funcs:Notify("Blueprints", "Couldn't read your blueprint data.")
		return
	end

	local ToBuy, Cost = {}, 0
	for _, Item in ipairs(Info:GetChildren()) do
		local Type = Item:FindFirstChild("Type")
		local Price = Item:FindFirstChild("Price")
		if Type and Price and (Type.Value == "Structure" or Type.Value == "Furniture")
			and Item:FindFirstChild("WoodCost") and not Owned:FindFirstChild(Item.Name) then
			table.insert(ToBuy, Item.Name)
			Cost = Cost + Price.Value
		end
	end

	if #ToBuy == 0 then
		Funcs:Notify("Building", "You already own every blueprint")
		return
	end

	local Money = GetMoney()
	if Money < Cost then
		Funcs:Notify("Building", "You need $" .. (Cost - Money) .. " more to buy every blueprint")
		return
	end

	local Root = GetRoot()
	if not Root then
		Funcs:Notify("Auto Buy couldn't start", "Auto Buy couldn't start: your character isn't loaded")
		return
	end

	Buy.running, Buy.abort = true, false
	local Home = Root.CFrame

	task.spawn(function()
		local Done, Unsold, Failure = 0, {}, nil

		for _, Name in ipairs(ToBuy) do
			if Buy.abort then break end

			local Ok, Success, Msg = pcall(Funcs.BuyBox, Funcs, Name, true, Home)
			if not Ok then
				Success, Msg = false, tostring(Success)
			end

			if Success then
				Done = Done + 1
			elseif Msg == "not on the shelf" then
				table.insert(Unsold, Name)
			else
				Failure = Msg
				break
			end
			task.wait()
		end

		local Aborted = Buy.abort
		Buy.running = false
		Funcs:TeleportTo(Home)

		if Aborted then return end
		if Done == #ToBuy and #Unsold == 0 then
			Funcs:Notify("Building", "Bought every blueprint")
			return
		end
		local Parts = { "Bought " .. Done .. " of " .. #ToBuy .. " blueprints." }
		if #Unsold > 0 then
			local Names = {}
			for _, Name in ipairs(Unsold) do
				local Item = Info:FindFirstChild(Name)
				local Label = Item and Item:FindFirstChild("ItemName")
				table.insert(Names, Label and Label.Value or Name)
			end
			table.insert(Parts, "Not sold in any shop yet: " .. table.concat(Names, ", "))
		end
		if Failure then
			table.insert(Parts, "Missed: " .. Failure)
		end
		Funcs:Notify("Building", table.concat(Parts, " "))
	end)
end

