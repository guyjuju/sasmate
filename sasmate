	Disconnect("BlueprintBars")

	if not Value then
		SetBlueprintBars(true)
		return
	end

	local Models = workspace:FindFirstChild("PlayerModels")
	if not Models then return end

	SetBlueprintBars(false)

	Connections.BlueprintBars = Models.ChildAdded:Connect(function(Model)
		local Type = Model:WaitForChild("Type", 3)
		local Main = Model:WaitForChild("Main", 3)
		if Type and Type.Value == "Blueprint" and Main then
			local Bar = Main:WaitForChild("ProgressBillboard", 3)
			if Bar then
				Bar.Enabled = false
			end
		end
	end)
end


