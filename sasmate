function Funcs:StopPadPicking()
	Disconnect("PadPick")
end

function Funcs:AbortCarSpawner()
	local Busy = Vehicle.spawning or Connections.PadPick
	Funcs:StopPadPicking()

	if Vehicle.spawning then
		Vehicle.abort = true
	end

	Funcs:Notify("Car Spawner", Busy and "Stopped." or "The spawner isn't running.")
end

-- Step 1: click one of your vehicle spots
function Funcs:StartCarSpawner()
	if Vehicle.spawning then
		Funcs:Notify("Car Spawner", "Already spawning. Press Abort first.")
		return
	end

	if not Vehicle.color then
		Funcs:Notify("Car Spawner", "Pick a car color first.")
		return
	end

	Funcs:StopPadPicking()
	Funcs:Notify("Car Spawner", "Click one of your vehicle spots.")

	Connections.PadPick = LocalPlayer:GetMouse().Button1Up:Connect(function()
		local Model = ClickedOwnModel()
		if not Model then return end

		local Type = Model:FindFirstChild("Type")
		if not Type or Type.Value ~= "Vehicle Spot" then return end

		local Button = Model:FindFirstChild("ButtonRemote_SpawnButton")
		if not Button then return end

		Funcs:StopPadPicking()
		task.spawn(function()
			Funcs:RunCarSpawner(Button)
		end)
	end)
end

-- Step 2: keep respawning the car until it comes out the color you want
function Funcs:RunCarSpawner(Button)
	Vehicle.spawning, Vehicle.abort = true, false

	local Models = workspace:FindFirstChild("PlayerModels")
	local Remote = ReplicatedStorage.Interaction.RemoteProxy
	local Tries, Result = 0, nil

	while not Vehicle.abort do
		local PaintPart
		local Watch = Models.ChildAdded:Connect(function(Model)
			local Owner = Model:WaitForChild("Owner", 3)
			if Owner and Owner.Value == LocalPlayer then
				local Paint = Model:WaitForChild("PaintParts", 3)
				local Part = Paint and Paint:WaitForChild("Part", 3)
				if Part then
					PaintPart = Part
				end
			end
		end)

		Remote:FireServer(Button)
		Tries = Tries + 1

		local Started = os.clock()
		while not PaintPart and not Vehicle.abort and os.clock() - Started < 10 do
			task.wait()
		end
		Watch:Disconnect()

		if not PaintPart then
			Result = Vehicle.abort and "Stopped" or "The car never appeared. Is the spot free?"
			break
		end

		task.wait(1.5)

		local Name = PaintPart.BrickColor.Name
		if Name == Vehicle.color or (Vehicle.stopOnPink and Name == "Hot pink") then
			Result = "Got a " .. Name .. " car after " .. Tries .. " tries."
			break
		end
	end

	Vehicle.spawning = false
	Funcs:Notify("Car Spawner", Result or ("Stopped after " .. Tries .. " tries."))
end


