local MapState = { water = false, bridgeDown = false, bpHighlight = false }

-- Hides (or shows) the water. Only the look changes, you can still swim
function Funcs:RemoveWater(Value)
	MapState.water = Value
	local Alpha = Value and 1 or 0

	local Folder = workspace:FindFirstChild("Water")
	if Folder then
		for _, Part in ipairs(Folder:GetChildren()) do
			if Part.Name == "Water" and Part:IsA("BasePart") then
				Part.Transparency = Alpha
			end
		end
	end

	local Bridge = workspace:FindFirstChild("Bridge")
	local Lift = Bridge and Bridge:FindFirstChild("VerticalLiftBridge")
	local Model = Lift and Lift:FindFirstChild("WaterModel")
	local Water = Model and Model:FindFirstChild("Water")
	if Water then
		Water.Transparency = Alpha
	end
end

-- Lowers (or raises) the lift bridge by 26 studs
function Funcs:BridgeDown(Value)
	if Value == MapState.bridgeDown then return end

	local Bridge = workspace:FindFirstChild("Bridge")
	local Lift = Bridge and Bridge:FindFirstChild("VerticalLiftBridge")
	if not Lift then
		Funcs:Notify("Bridge", "Couldn't find the bridge.")
		return
	end

	local Offset = Vector3.new(0, Value and -26 or 26, 0)
	for _, Name in ipairs({ "Lift", "Weight" }) do
		local Folder = Lift:FindFirstChild(Name)
		if Folder then
			for _, Part in ipairs(Folder:GetChildren()) do
				if Part:IsA("BasePart") then
					Part.CFrame = Part.CFrame + Offset
				end
			end
		end
	end

	MapState.bridgeDown = Value
end

-- Moves every TreeRegion out of the map (and back). Hidden trees can't be chopped,
-- so Bring Wood refuses to run while they're hidden
function Funcs:HideTrees(Value)
	Funcs.TreesHidden = Value

	local From = Value and workspace or Lighting
	local To = Value and Lighting or workspace

	for _, Child in ipairs(From:GetChildren()) do
		if Child.Name == "TreeRegion" then
			Child.Parent = To
		end
	end
end

-- Turns off the blue blueprint selection highlight
function Funcs:BlueprintHighlight(Value)
	MapState.bpHighlight = Value

	for _, Key in ipairs({ "BPHighlightA", "BPHighlightB" }) do
		if Connections[Key] then
			Connections[Key]:Disconnect()
			Connections[Key] = nil
		end
	end
	if not Value then return end

	local Effects = workspace:FindFirstChild("Effects")
	if not Effects then
		Funcs:Notify("Blueprints", "Couldn't find the effects folder.")
		return
	end

	Connections.BPHighlightA = Effects.ChildAdded:Connect(function(Effect)
		local Box = Effect:WaitForChild("SelectionBox", 3)
		if Box then
			Box.Visible = false
		end
	end)

	Connections.BPHighlightB = Effects.ChildAdded:Connect(function(Effect)
		local Highlight = Effect:WaitForChild("Highlight", 3)
		if Highlight then
			task.wait(0.5)
			Highlight.Parent = Lighting
		end
	end)
end

-- The green box at the top of the volcano (counts as the win)
local function GetGreenBoxPart()
	local Region = workspace:FindFirstChild("Region_Volcano")
	return Region and Region:FindFirstChild("VolcanoWin")
end

function Funcs:GetGreenBox()
	local Box = GetGreenBoxPart()
	local Root = GetRoot()
	if not Box then
		Funcs:Notify("Green Box", "Couldn't find the green box.")
		return
	end
	if not Root then return end

	if typeof(firetouchinterest) ~= "function" then
		Funcs:Notify("Green Box", "Your executor doesn't support firetouchinterest.")
		return
	end

	firetouchinterest(Root, Box, 0)
	task.wait()
	firetouchinterest(Root, Box, 1)
end

-- Frees the green box from the volcano so it can be carried off
function Funcs:DestroyGreenBox()
	local Box = GetGreenBoxPart()
	local Root = GetRoot()
	if not Box then
		Funcs:Notify("Green Box", "Couldn't find the green box.")
		return
	end
	if not Root then return end

	local Home = Root.CFrame
	Root.CFrame = Box.CFrame
	task.wait(0.2)

	ReplicatedStorage.Interaction.ClientIsDragging:FireServer(Box)

	for _, Name in ipairs({ "BodyPosition", "BodyAngularVelocity" }) do
		local Mover = Box:FindFirstChild(Name)
		if Mover then
			Mover:Destroy()
		end
	end

	task.wait(1)
	Funcs:TeleportTo(Home)
end


