--
local AO = { Target = LocalPlayer, Rate = 6, Running = false, Tried = {} }

function AO.Owner(Model)
	local Owner = Model:FindFirstChild("Owner")
	if Owner and Owner:IsA("ObjectValue") then return Owner.Value end
	return nil
end

function AO.IsBox(Model)
	return Model:IsA("Model") and Model:FindFirstChild("PurchasedBoxItemName") ~= nil
end

-- gifts, presents, candy bags and crates open through the item button instead
function AO.IsGift(Model)
	if not Model:IsA("Model") or AO.IsBox(Model) then return false end
	local Name = Model:FindFirstChild("ItemName")
	if not Name or not Model:FindFirstChild("DraggableItem") then return false end
	local Lower = string.lower(tostring(Name.Value))
	return (Lower:find("gift") or Lower:find("present") or Lower:find("candy") or Lower:find("bag") or Lower:find("crate") or Lower:find("box")) ~= nil
end

function AO.GetBoxes()
	local List = {}
	local Folder = workspace:FindFirstChild("PlayerModels")
	if not Folder then return List end
	for _, Model in ipairs(Folder:GetChildren()) do
		if (AO.IsBox(Model) or AO.IsGift(Model)) and AO.Owner(Model) == AO.Target then
			table.insert(List, Model)
		end
	end
	return List
end

function AO.Open(Box)
	local Now = os.clock()
	if AO.Tried[Box] and Now - AO.Tried[Box] < 0.8 then return false end
	AO.Tried[Box] = Now
	local Interaction = ReplicatedStorage:FindFirstChild("Interaction")
	if not Interaction then return false end
	if AO.IsBox(Box) then
		pcall(function() Interaction.ClientInteracted:FireServer(Box, "Open box") end)
	else
		pcall(function() Interaction.RemoteProxy:FireServer(Box) end)
		local Button = Box:FindFirstChild("ButtonRemote_Main")
		if Button then
			pcall(function() Interaction.RemoteProxy:FireServer(Button) end)
		end
	end
	return true
end

function AO.Pass()
	local Count = 0
	for _, Box in ipairs(AO.GetBoxes()) do
		if Box.Parent and AO.Open(Box) then
			Count = Count + 1
			task.wait(1 / math.max(AO.Rate, 1))
		end
	end
	return Count
end

function AO.PlayerNames()
	local Names = {}
	for _, Player in ipairs(Players:GetPlayers()) do
		table.insert(Names, Player.Name)
	end
	table.sort(Names)
	return Names
end

function Funcs:AutoOpenBoxes(Value)
	AO.Running = Value
	if not Value then return end
	task.spawn(function()
		while AO.Running do
			if AO.Pass() == 0 then task.wait(0.2) end
		end
	end)
end

function Funcs:OpenBoxesNow()
	local Found = #AO.GetBoxes()
	if Found == 0 then
		Funcs:Notify("Auto Open", "No boxes found for " .. AO.Target.Name)
		return
	end
	task.spawn(function()
		local Tried = AO.Pass()
		Funcs:Notify("Auto Open", "Found " .. Found .. ", tried " .. Tried)
	end)
end

