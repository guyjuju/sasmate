	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 250)
	Corner.Parent = Btn

	local Stroke = Instance.new("UIStroke")
	Stroke.Color = Color3.fromRGB(60, 20, 110)
	Stroke.Thickness = 2
	Stroke.Parent = Btn

	Flight.gui, Flight.button = Gui, Btn

	local Dragging, Moved, DragStart, StartPos = false, false, nil, nil
	local Conns = {}
	Flight.btnConns = Conns

	table.insert(Conns, Btn.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseButton1 then
			Dragging, Moved = true, false
			DragStart, StartPos = Input.Position, Btn.Position
		end
	end))

	table.insert(Conns, UserInputService.InputChanged:Connect(function(Input)
		if Dragging and (Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseMovement) then
			local Delta = Input.Position - DragStart
			if Delta.Magnitude > 8 then Moved = true end
			if Moved then
				Btn.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + Delta.X, StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y)
			end
		end
	end))

	table.insert(Conns, UserInputService.InputEnded:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.Touch or Input.UserInputType == Enum.UserInputType.MouseButton1 then
			Dragging = false
		end
	end))

	table.insert(Conns, Btn.MouseButton1Click:Connect(function()
		if not Moved then
			Funcs:ToggleFlight()
		end
	end))
end

local MoveKeys = {
	[Enum.KeyCode.W] = { "f", 1 },
	[Enum.KeyCode.S] = { "b", -1 },
	[Enum.KeyCode.A] = { "l", -1 },
	[Enum.KeyCode.D] = { "r", 1 },
}

UserInputService.InputBegan:Connect(function(Input, Processed)
	if Processed then return end

	local Move = MoveKeys[Input.KeyCode]
	if Move then
		Flight.ctrl[Move[1]] = Move[2]
	end
end)

UserInputService.InputEnded:Connect(function(Input)
	local Move = MoveKeys[Input.KeyCode]
	if Move then
		Flight.ctrl[Move[1]] = 0
	end
end)


