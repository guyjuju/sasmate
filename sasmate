-- Stronger, snappier item dragging
function Funcs:HardDragger(Value)
	Disconnect("HardDragger")
	if not Value then return end

	Connections.HardDragger = workspace.ChildAdded:Connect(function(Dragger)
		if Dragger.Name ~= "Dragger" then return end

		local Gyro = Dragger:WaitForChild("BodyGyro", 3)
		local Position = Dragger:WaitForChild("BodyPosition", 3)
		if not Gyro or not Position then return end

		Dragger.BrickColor = BrickColor.new("Hot pink")

		repeat
			Position.P = 80000
			Position.D = 1000
			Position.MaxForce = Vector3.new(1, 1, 1) * 1000000
			Gyro.MaxTorque = Vector3.new(1, 1, 1) * 200
			Gyro.P = 1200
			Gyro.D = 140
			task.wait()
		until not Dragger.Parent or not Position.Parent

		if Dragger.Parent then
			Dragger.BrickColor = BrickColor.new("Deep blue")
		end
	end)
end

