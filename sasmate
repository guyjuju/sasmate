local TakeControl, Drag

function Funcs:GetTreeRegions()
	local Regions = {}
	for _, Child in ipairs(workspace:GetChildren()) do
		if Child.Name == "TreeRegion" then
			table.insert(Regions, Child)
		end
	end
	return Regions
end

-- Every wood type that currently exists in the map
function Funcs:GetTreeClasses()
	local Classes = {}
	for _, Region in ipairs(Funcs:GetTreeRegions()) do
		for _, Tree in ipairs(Region:GetChildren()) do
			local Class = Tree:FindFirstChild("TreeClass")
			if Class and not table.find(Classes, Class.Value) then
				table.insert(Classes, Class.Value)
			end
		end
	end
	table.sort(Classes)
	return Classes
end

function Funcs:GetAxeStats(AxeName, TreeClass)
	local Folder = ReplicatedStorage:FindFirstChild("AxeClasses")
	local Module = Folder and Folder:FindFirstChild("AxeClass_" .. AxeName)
	if not Module then return nil end

	local Ok, Stats = pcall(function()
		return require(Module).new()
	end)
	if not Ok or not Stats then return nil end

	if Stats.SpecialTrees and Stats.SpecialTrees[TreeClass] then
		for Key, Val in next, Stats.SpecialTrees[TreeClass] do
			Stats[Key] = Val
		end
	end
	return Stats
end

function Funcs:GetBestAxe(TreeClass)
	local Required = TreeClass == "LoneCave" and "EndTimesAxe" or nil
	local Best, BestStats
	local function Consider(Tool)
		if not Tool:IsA("Tool") or Tool.Name == "BlueprintTool" then return end
		local ToolName = Tool:FindFirstChild("ToolName")
		if not ToolName then return end
		if Required and ToolName.Value ~= Required then return end
		local Stats = Funcs:GetAxeStats(ToolName.Value, TreeClass)
		if Stats and (not BestStats or Stats.Damage > BestStats.Damage) then
			Best, BestStats = Tool, Stats
		end
	end
	for _, Tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
		Consider(Tool)
	end
	local Held = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
	if Held then
		Consider(Held)
	end
	return Best, BestStats
end

local function CountAxes()
	local Count = 0
	for _, Tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
		if Tool:IsA("Tool") then
			Count = Count + 1
		end
	end
	return Count
end

function Funcs:PickUpBetterAxe(TreeClass, BestDamage)
	local Required = TreeClass == "LoneCave" and "EndTimesAxe" or nil
	local Best, BestValue = nil, BestDamage or 0
	for _, Model in ipairs(workspace.PlayerModels:GetChildren()) do
		local ToolName = Model:FindFirstChild("ToolName")
		local Owner = Model:FindFirstChild("Owner")
		if ToolName and Owner and Owner.Value == LocalPlayer then
			if not (Required and ToolName.Value ~= Required) then
				local Stats = Funcs:GetAxeStats(ToolName.Value, TreeClass)
				if Stats and Stats.Damage > BestValue then
					Best, BestValue = Model, Stats.Damage
				end
			end
		end
	end
	if not Best then return false end
	local Before = CountAxes()
	ReplicatedStorage.Interaction.ClientInteracted:FireServer(Best, "Pick up tool")
	task.wait(0.5)
	if CountAxes() > Before then return true end
	ReplicatedStorage.Interaction.ClientInteracted:FireServer(Best, "Pick up tool")
	task.wait(0.5)
	return CountAxes() > Before
end

function Funcs:EnsureBestAxe(TreeClass)
	local Axe, Stats = Funcs:GetBestAxe(TreeClass)
	local Carried = Stats and Stats.Damage or 0
	if Funcs:PickUpBetterAxe(TreeClass, Carried) then
		Axe, Stats = Funcs:GetBestAxe(TreeClass)
	end
	return Axe, Stats
end

local function GetModelMass(Model)
	local Total, Sections = 0, 0
	for _, Part in ipairs(Model:GetDescendants()) do
		if Part:IsA("BasePart") then
			if Part.Name == "WoodSection" then
				Sections = Sections + 1
			end
			Total = Total + Part:GetMass()
		end
	end
	return Total, Sections
end

-- Heaviest unowned tree of the given wood type
function Funcs:FindTree(TreeClass)
	local Found = {}
	for _, Region in ipairs(Funcs:GetTreeRegions()) do
		for _, Tree in ipairs(Region:GetChildren()) do
			if Tree:IsA("Model") and Tree:FindFirstChild("CutEvent") then
				local Class = Tree:FindFirstChild("TreeClass")
				local Owner = Tree:FindFirstChild("Owner")
				if Owner and Class and Owner.Value == nil and Class.Value == TreeClass then
					local Mass, Sections = GetModelMass(Tree)
					if Sections > 1 then
						table.insert(Found, { Tree = Tree, Mass = Mass })
					end
				end
			end
		end
	end
	table.sort(Found, function(A, B)
		return A.Mass > B.Mass
	end)
	return Found[1] and Found[1].Tree or nil
end

function Funcs:ResetRootJoint()
	local Root = GetRoot()
	local Joint = Root and Root:FindFirstChild("RootJoint")
	if Joint then
		Joint:Clone().Parent = Joint.Parent
		Joint:Destroy()
		task.wait()
	end
end

-- Swings the axe until a log owned by you appears (or the toggle is switched off)
function Funcs:ChopTree(Tree, Axe, Stats, TreeClass)
	local Root, Hum = GetRoot()
	local Section = Tree:FindFirstChild("WoodSection")
	if not Root or not Hum or not Section then return nil end

	Root.CFrame = CFrame.new(Section.Position + Vector3.new(5, 0, 0))
	task.wait(0.25)

	local SectionId = Section:FindFirstChild("ID")
	local Props = {
		tool         = Axe,
		height       = 0.3,
		faceVector   = Vector3.new(1, 0, 0),
		sectionId    = SectionId and SectionId.Value or 1,
		hitPoints    = Stats.Damage,
		cooldown     = Stats.SwingCooldown,
		cuttingClass = "Axe",
	}

	local NewLog
	local Conn = workspace.LogModels.ChildAdded:Connect(function(Log)
		task.wait()
		local Owner = Log:FindFirstChild("Owner")
		if Owner and Owner.Value == LocalPlayer then
			NewLog = Log
		end
	end)

	local Remote = ReplicatedStorage.Interaction.RemoteProxy
	local Started = os.clock()

	while not NewLog and Wood.active == TreeClass and Tree.Parent and Hum.Parent and Hum.Health > 0 and os.clock() - Started < 60 do
		Remote:FireServer(Tree.CutEvent, Props)
		task.wait(Stats.SwingCooldown)
	end

	Conn:Disconnect()
	return NewLog
end

-- Finds, chops and brings one tree of this wood type to where you stood
function Funcs:BringTree(TreeClass, HomeOverride)
	local Root, Hum = GetRoot()
	if not Root or not Hum then return false, "your character isn't loaded" end

	local Home = HomeOverride or Root.CFrame
	Funcs:StopFlight()
	Hum:UnequipTools()
	task.wait()

	local Axe, Stats = Funcs:EnsureBestAxe(TreeClass)
	if not Axe then return false, "You need an axe for this" end

	local Tree = Funcs:FindTree(TreeClass)
	if not Tree then return false, "No " .. TreeClass .. " trees are left" end

	local LoneCave = TreeClass == "LoneCave"
	if LoneCave then
		if Axe.ToolName.Value ~= "EndTimesAxe" then
			return false, "You need an EndTimes axe to cut the LoneCave tree"
		end
		Funcs:ResetRootJoint()
		if Axe.Parent ~= LocalPlayer.Character then
			Hum:EquipTool(Axe)
			task.wait(0.3)
		end
	end

	local Log = Funcs:ChopTree(Tree, Axe, Stats, TreeClass)
	if not Log then return false, "Tree cutting stopped" end

	task.wait(0.15)
	local Section = Log:FindFirstChild("WoodSection")
	if not Section then return false, "Log has no wood section" end

	Log.PrimaryPart = Section
	Wood.haul = Log
	TakeControl(Log, Section, 6, function() return Wood.active == TreeClass end)
	for _ = 1, 60 do
		if Wood.active ~= TreeClass then return false end
		Drag(Log)
		Log:PivotTo(Home)
		task.wait()
	end
	Wood.haul = nil

	-- LoneCave: respawn so the log stays put
	if LoneCave then
		local _, H = GetRoot()
		if H then H:UnequipTools() end
		task.wait()
		local Char = LocalPlayer.Character
		if Char and Char:FindFirstChild("Head") then
			Char.Head:Destroy()
		end
		LocalPlayer.CharacterAdded:Wait()
		task.wait(1.5)
	end

	local NewRoot = GetRoot()
	if NewRoot then
		NewRoot.CFrame = Section.CFrame
	end

	return true, "Got the tree!"
end

-- Teleports you to the middle of your own base (property)
function Funcs:ReturnToBase()
	local Root = GetRoot()
	local Properties = workspace:FindFirstChild("Properties")
	if not Root or not Properties then return false end

	for _, Property in ipairs(Properties:GetChildren()) do
		local Owner = Property:FindFirstChild("Owner")
		local Origin = Property:FindFirstChild("OriginSquare")
		if Owner and Owner.Value == LocalPlayer and Origin then
			Root.CFrame = Origin.CFrame + Vector3.new(0, 5, 0)
			return true
		end
	end

	return false
end

-- Brings ONE tree of this wood type, then stops
function Funcs:BringOnce(TreeClass)
	if type(TreeClass) == "table" then TreeClass = TreeClass[1] end
	if not TreeClass then return end

	if Funcs.TreesHidden then
		Funcs:Notify("Trees", "Trees are hidden. Turn off Remove Trees in the World tab first.")
		return
	end

	if Wood.running then
		Funcs:Notify("Trees", "Already cutting a tree")
		return
	end

	local StartRoot = GetRoot()
	if not StartRoot then
		Funcs:Notify("Trees", "Tree cutting stopped: your character isn't loaded")
		return
	end

	if not Funcs:EnsureBestAxe(TreeClass) then
		Funcs:Notify("Trees", "You need an axe for this")
		return
	end

	Wood.running = true
	Wood.active = TreeClass
	Wood.returnPending = false

	local Total = Config.treeCount
	local Home = StartRoot.CFrame -- every log is dropped at the spot you started from

	task.spawn(function()
		local Done, Failure = 0, nil

		for _ = 1, Total do
			if Wood.active ~= TreeClass then break end -- Stop was pressed

			local Ok, Success, Msg = pcall(Funcs.BringTree, Funcs, TreeClass, Home)
			if not Ok then
				Success, Msg = false, tostring(Success)
			end

			if not Success then
				Failure = Msg
				break
			end

			Done = Done + 1
			task.wait(0.5)
		end

		local Stopped = Wood.returnPending

		Wood.active = nil
		Wood.running = false

		if Stopped then
			Wood.returnPending = false
			local RootNow = GetRoot()
			if RootNow then
				RootNow.CFrame = Home
				local Haul = Wood.haul
				Wood.haul = nil
				if Haul and Haul.Parent then
					local Part = Haul:FindFirstChild("WoodSection") or Haul:FindFirstChildWhichIsA("BasePart", true)
					if Part then
						TakeControl(Haul, Part, 3)
						Haul:PivotTo(Home)
					end
				end
			end
		elseif Failure then
			if Failure == "Tree cutting stopped" then
				Funcs:Notify("Trees", Failure)
			else
				Funcs:Notify("Trees", "Tree cutting stopped: " .. Failure)
			end
		else
			Funcs:Notify("Trees", string.format("Got %d tree(s)", Done))
		end
	end)
end

-- Cancels the current chop (if any) and teleports you to your base
function Funcs:StopWood()
	if Wood.running then
		Wood.active = nil
		Wood.returnPending = true
	elseif not Funcs:ReturnToBase() then
		Funcs:Notify("Land", "Couldn't find the plot")
	end
end



