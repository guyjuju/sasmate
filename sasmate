-- A red Abort button that stays on screen while you are picking or stacking
function Funcs:ShowAbortButton()
	if game.CoreGui:FindFirstChild("SasMateAbortStack") then return end

	local Gui = Instance.new("ScreenGui")
	Gui.Name = "SasMateAbortStack"
	Gui.ResetOnSpawn = false
	Gui.DisplayOrder = 999

	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(0, 120, 0, 44)
	Button.Position = UDim2.new(0.5, -60, 0, 70)
	Button.BackgroundColor3 = Color3.fromRGB(190, 55, 55)
	Button.TextColor3 = Color3.new(1, 1, 1)
	Button.Font = Enum.Font.GothamBold
	Button.TextSize = 15
	Button.Text = "ABORT STACK"
	Button.Active = true
	Button.Draggable = true
	Button.Parent = Gui
	Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 8)

	Button.MouseButton1Click:Connect(function()
		Funcs:AbortStacking()
	end)

	Gui.Parent = game.CoreGui

	-- remove it by itself once nothing is being picked or stacked
	task.spawn(function()
		task.wait(0.5)
		while Gui.Parent and (ItemState.stacking or Connections.StackSelect or Connections.StackMove or Connections.StackClick) do
			task.wait(0.3)
		end
		Gui:Destroy()
	end)
end

function Funcs:StopStackPicking()
	Disconnect("StackSelect")
	Disconnect("StackMove")
	Disconnect("StackClick")
	LocalPlayer:GetMouse().TargetFilter = nil

	local Preview = workspace:FindFirstChild("SasMateStackPreview")
	if Preview then
		Preview:Destroy()
	end
end

function Funcs:AbortStacking()
	local Busy = ItemState.stacking or Connections.StackSelect or Connections.StackClick
	Funcs:StopStackPicking()

	if ItemState.stacking then
		ItemState.abort = true
	end

	Funcs:Notify("Stacker", Busy and "Stopped stacking." or "Nothing is being stacked.")
end

-- Step 1: click one of your items to choose what to stack
function Funcs:Stack()
	if ItemState.stacking then
		Funcs:Notify("Stacker", "Already stacking. Press Abort first.")
		return
	end

	Funcs:StopStackPicking()
	Funcs:ShowAbortButton()
	Funcs:Notify("Stacker", "Click one of your items to choose what to stack.")

	Connections.StackSelect = LocalPlayer:GetMouse().Button1Down:Connect(function()
		local Model = ClickedOwnModel()
		if not Model then return end

		local Key, Value = ItemKind(Model)
		if not Key then return end

		Disconnect("StackSelect")
		Funcs:PickStackSpot(Key, Value)
	end)
end

-- How many layers tall the stack is: your Height setting, or as many as needed when it's 0
local function StackHeight(Count, XCount, ZCount)
	if ItemState.y > 0 then
		return ItemState.y
	end
	return math.ceil(Count / (XCount * ZCount))
end

-- Step 2: a preview box follows the mouse over your land; click to place the stack
function Funcs:PickStackSpot(Key, Value)
	local List = GetSameItems(Key, Value)
	if #List == 0 then
		Funcs:Notify("Stacker", "Couldn't find any of those.")
		return
	end

	local Size = List[1].Main.Size
	local XCount, ZCount = ItemState.x, ItemState.z
	local YCount = StackHeight(#List, XCount, ZCount)
	if #List > XCount * YCount * ZCount then
		Funcs:Notify("Stacker", "Your size only fits " .. (XCount * YCount * ZCount) .. " of " .. #List .. " items. Raise the Height to fit them all.")
	end
	local Box = Vector3.new(Size.X * XCount, Size.Y * YCount, Size.Z * ZCount)

	local Preview = Instance.new("Part")
	Preview.Name = "SasMateStackPreview"
	Preview.Anchored = true
	Preview.CanCollide = false
	Preview.CanQuery = false
	Preview.CanTouch = false
	Preview.Transparency = 1
	Preview.Size = Box
	Preview.Parent = workspace

	local Outline = Instance.new("SelectionBox")
	Outline.Adornee = Preview
	Outline.LineThickness = 0.1
	Outline.Parent = Preview

	local Mouse = LocalPlayer:GetMouse()
	Mouse.TargetFilter = Preview

	Funcs:Notify("Stacker", "Found " .. #List .. ". Move over your land and click to place the stack.")

	Connections.StackMove = Mouse.Move:Connect(function()
		local Target = Mouse.Target
		if Target and (Target.Name == "Square" or Target.Name == "OriginSquare") then
			Preview.CFrame = CFrame.new(Mouse.Hit.Position + Vector3.new(Box.X / 2, Box.Y / 2, Box.Z / 2))
		end
	end)

	local Placed = false
	Connections.StackClick = Mouse.Button1Down:Connect(function()
		if Placed then return end
		Placed = true

		local Origin = Mouse.Hit.Position
		Funcs:StopStackPicking()
		Mouse.TargetFilter = nil

		task.spawn(function()
			Funcs:RunStack(List, Origin)
		end)
	end)
end

-- Step 3: move every item into its slot in the grid
function Funcs:RunStack(List, Origin)
	local Root = GetRoot()
	if not Root then return end

	ItemState.stacking, ItemState.abort = true, false
	Funcs:ShowAbortButton()
	local Home = Root.CFrame
	local Size = List[1].Main.Size
	local XCount, ZCount = ItemState.x, ItemState.z
	local Placed = 0

	local Ok, Err = pcall(function()
		local Index = 0
		for Y = 1, StackHeight(#List, XCount, ZCount) do
			for X = 1, XCount do
				for Z = 1, ZCount do
					if ItemState.abort then return end

					Index = Index + 1
					local Item = List[Index]
					local Main = Item and Item:FindFirstChild("Main")
					if Item and Item.Parent and Main then
						local Spot = Origin + Vector3.new((X - 0.5) * Size.X, (Y - 0.5) * Size.Y + 0.1, (Z - 0.5) * Size.Z)

						-- Stand next to it and take control of it
						Funcs:TeleportTo(CFrame.new(Main.Position + Vector3.new(Size.Z + 3, 1, 0)))
						task.wait(0.1)
						TakeControl(Item, Main, 4, function() return not ItemState.abort end)

						local Freeze = Instance.new("BodyVelocity")
						Freeze.Velocity = Vector3.zero
						Freeze.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
						Freeze.Parent = Main

						for _ = 1, ItemState.iteration do
							if ItemState.abort or not Item.Parent then break end
							Main.AssemblyLinearVelocity = Vector3.zero
							Drag(Item)
							Item:PivotTo(CFrame.new(Spot))
							task.wait()
						end

						Placed = Placed + 1
						task.delay(5, function()
							if Freeze.Parent then Freeze:Destroy() end
						end)
					end
				end
			end
		end
	end)

	ItemState.stacking = false
	Funcs:TeleportTo(Home)

	if not Ok then
		Funcs:Notify("Stacker", "Stopped: " .. tostring(Err))
	elseif ItemState.abort then
		Funcs:Notify("Stacker", "Stopped after " .. Placed .. "/" .. #List .. ".")
	else
		Funcs:Notify("Stacker", "Stacked " .. Placed .. "/" .. #List .. ".")
	end
end


-- Group Select: click one item and every item of that kind on your base is selected
--
local GS = { Key = nil, Value = nil, Boxes = {} }

local function GroupKind(Model)
	for _, Key in ipairs({ "ItemName", "PurchasedBoxItemName", "ToolName", "TreeClass" }) do
		local Found = Model:FindFirstChild(Key)
		if Found then
			return Key, Found.Value
		end
	end
	return nil
end

function Funcs:ClearGroupSelect()
	for _, Box in ipairs(GS.Boxes) do
		Box:Destroy()
	end
	GS.Boxes, GS.Key, GS.Value = {}, nil, nil
end

function Funcs:GetGroup()
	if not GS.Key then return {} end
	return GetSameItems(GS.Key, GS.Value, true)
end

function Funcs:GroupSelect(Value)
	Disconnect("GroupSelect")
	if not Value then
		Funcs:ClearGroupSelect()
		return
	end

	Funcs:Notify("Group Select", "Click one of your items to select every one of that kind.")

	Connections.GroupSelect = LocalPlayer:GetMouse().Button1Down:Connect(function()
		local Model = ClickedOwnModel()
		if not Model then return end

		local Key, Kind = GroupKind(Model)
		if not Key then return end

		Funcs:ClearGroupSelect()
		GS.Key, GS.Value = Key, Kind

		local List = Funcs:GetGroup()
		for _, Item in ipairs(List) do
			local Outline = Instance.new("SelectionBox")
			Outline.Name = "SasMateSelect"
			Outline.Adornee = Item
			Outline.Color3 = Color3.fromRGB(80, 200, 120)
			Outline.LineThickness = 0.05
			Outline.Parent = Item
			table.insert(GS.Boxes, Outline)
		end

		Funcs:Notify("Group Select", "Selected " .. #List .. " x " .. tostring(Kind))
	end)
end

-- Brings every selected item to you
function Funcs:BringGroup()
	local List = Funcs:GetGroup()
	local Root = GetRoot()
	if #List == 0 or not Root then
		Funcs:Notify("Group Select", "Nothing is selected")
		return
	end

	task.spawn(function()
		local Count = 0
		for _, Item in ipairs(List) do
			local Main = Item:FindFirstChild("Main") or Item.PrimaryPart or Item:FindFirstChildWhichIsA("BasePart", true)
			if Item.Parent and Main then
				Item.PrimaryPart = Main
				pcall(function()
					ReplicatedStorage.Interaction.Verify:FireServer("Item owned by player", Item)
				end)
				Item:SetPrimaryPartCFrame(Root.CFrame + Vector3.new(0, 4, 0))
				Drag(Item)
				Count = Count + 1
				task.wait()
			end
		end
		Funcs:Notify("Group Select", "Brought " .. Count .. " items")
	end)
end

-- Opens the stacker with the selected kind already chosen
function Funcs:StackGroup()
	if not GS.Key then
		Funcs:Notify("Group Select", "Select something first")
		return
	end
	if ItemState.stacking then
		Funcs:Notify("Stacker", "Already stacking. Press Abort first.")
		return
	end
	Funcs:StopStackPicking()
	Funcs:ShowAbortButton()
	Funcs:PickStackSpot(GS.Key, GS.Value)
end

