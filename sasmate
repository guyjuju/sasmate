-- Harmless fun that only changes how you look and move.
local Troll = { SpinSpeed = 20, LagRate = 4, Conns = {} }

local function TrollParts()
	local Char = LocalPlayer.Character
	return Char, Char and Char:FindFirstChildOfClass("Humanoid"), Char and Char:FindFirstChild("HumanoidRootPart")
end

local function TrollStop(Key)
	if Troll.Conns[Key] then
		Troll.Conns[Key]:Disconnect()
		Troll.Conns[Key] = nil
	end
end

function Funcs:Spin(Value)
	TrollStop("Spin")
	local _, _, Root = TrollParts()
	if Root then
		local Old = Root:FindFirstChild("SasMateSpin")
		if Old then Old:Destroy() end
	end
	if not Value then return end
	Troll.Conns.Spin = RunService.Heartbeat:Connect(function(Delta)
		local _, Hum, Root = TrollParts()
		if Root and Hum and Hum.Health > 0 then
			Root.CFrame = Root.CFrame * CFrame.Angles(0, math.rad(Troll.SpinSpeed * 18) * Delta, 0)
		end
	end)
end

function Funcs:LayDown(Value)
	TrollStop("Lay")
	local _, Hum = TrollParts()
	if not Hum then return end
	Hum.PlatformStand = Value and true or false
	if not Value then return end
	Troll.Conns.Lay = RunService.Heartbeat:Connect(function()
		local _, H = TrollParts()
		if H then H.PlatformStand = true end
	end)
end

function Funcs:FakeLag(Value)
	TrollStop("Lag")
	local _, _, Root = TrollParts()
	if Root and not Value then Root.Anchored = false end
	if not Value then return end
	local Timer = 0
	Troll.Conns.Lag = RunService.Heartbeat:Connect(function(Delta)
		local _, _, R = TrollParts()
		if not R then return end
		Timer = Timer + Delta
		if Timer >= 1 / Troll.LagRate then
			Timer = 0
			R.Anchored = not R.Anchored
		end
	end)
end

function Funcs:JumpSpam(Value)
	TrollStop("Jump")
	if not Value then return end
	Troll.Conns.Jump = RunService.Heartbeat:Connect(function()
		local _, Hum = TrollParts()
		if Hum then Hum.Jump = true end
	end)
end

function Funcs:Ragdoll()
	local _, Hum = TrollParts()
	if Hum then
		Hum:ChangeState(Enum.HumanoidStateType.Physics)
		task.delay(2.5, function()
			if Hum and Hum.Parent then Hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
		end)
	end
end

function Funcs:Headless(Value)
	local Char = LocalPlayer.Character
	local Head = Char and Char:FindFirstChild("Head")
	if Head then Head.Transparency = Value and 1 or 0 end
	local Face = Head and Head:FindFirstChildOfClass("Decal")
	if Face then Face.Transparency = Value and 1 or 0 end
end

-- Claims every tree in the game: cuts each one once (so it becomes yours), skipping LoneCave
local Claim = { running = false, claimed = 0 }

function Funcs:ClaimAllTrees(Value)
	if not Value then
		Claim.running = false
		return
	end
	if Claim.running then return end
	Claim.running = true
	Claim.claimed = 0

	task.spawn(function()
		local Root, Hum = GetRoot()
		if not Root or not Hum then
			Claim.running = false
			Funcs:Notify("Claim All Trees", "Your character isn't loaded")
			return
		end

		local Start = Root.CFrame
		Funcs:StopFlight()

		-- every unowned tree except LoneCave
		local Trees = {}
		for _, Region in ipairs(Funcs:GetTreeRegions()) do
			for _, Tree in ipairs(Region:GetChildren()) do
				local Class = Tree:FindFirstChild("TreeClass")
				local Owner = Tree:FindFirstChild("Owner")
				if Tree:IsA("Model") and Tree:FindFirstChild("CutEvent") and Tree:FindFirstChild("WoodSection")
					and Class and Class.Value ~= "LoneCave" and Owner and Owner.Value == nil then
					table.insert(Trees, Tree)
				end
			end
		end
		local Total = #Trees
		Funcs:Notify("Claim All Trees", "Claiming " .. Total .. " trees")

		local AxeFor = {}
		local Position = Root.Position

		while Claim.running and #Trees > 0 do
			-- go to the closest tree next so it doesn't run back and forth
			local BestIndex, BestDistance = 1, math.huge
			for Index, Tree in ipairs(Trees) do
				local Section = Tree:FindFirstChild("WoodSection")
				if Section then
					local Distance = (Section.Position - Position).Magnitude
					if Distance < BestDistance then
						BestIndex, BestDistance = Index, Distance
					end
				end
			end
			local Tree = table.remove(Trees, BestIndex)

			local Root2, Hum2 = GetRoot()
			if not Root2 or not Hum2 or Hum2.Health <= 0 then break end

			local Class = Tree:FindFirstChild("TreeClass")
			local Owner = Tree:FindFirstChild("Owner")
			local Section = Tree:FindFirstChild("WoodSection")
			if Tree.Parent and Class and Section and Owner and Owner.Value == nil then
				local TreeClass = Class.Value
				if not AxeFor[TreeClass] then
					local Axe, Stats = Funcs:EnsureBestAxe(TreeClass)
					AxeFor[TreeClass] = Axe and { Axe = Axe, Stats = Stats } or false
				end
				local Have = AxeFor[TreeClass]

				if Have and Have.Axe.Parent then
					Root2.CFrame = CFrame.new(Section.Position + Vector3.new(5, 0, 0))
					Position = Section.Position
					if Have.Axe.Parent ~= LocalPlayer.Character then
						pcall(function() Hum2:EquipTool(Have.Axe) end)
					end
					task.wait(0.15)

					local SectionId = Section:FindFirstChild("ID")
					local Props = {
						tool         = Have.Axe,
						height       = 0.3,
						faceVector   = Vector3.new(1, 0, 0),
						sectionId    = SectionId and SectionId.Value or 1,
						hitPoints    = Have.Stats.Damage,
						cooldown     = Have.Stats.SwingCooldown,
						cuttingClass = "Axe",
					}

					-- one hit only, so the tree is claimed but not chopped down
					ReplicatedStorage.Interaction.RemoteProxy:FireServer(Tree.CutEvent, Props)
					task.wait(Have.Stats.SwingCooldown)
					local Got = true
					if Got then Claim.claimed = Claim.claimed + 1 end
				end
			end
		end

		local Done = not Claim.running
		Claim.running = false
		local RootEnd = GetRoot()
		if RootEnd then RootEnd.CFrame = Start end
		Funcs:Notify("Claim All Trees", (Done and "Stopped. " or "Finished. ") .. "Hit " .. Claim.claimed .. " of " .. Total .. " trees")
	end)
end

-- Auto Chop Nearby: swings at every tree within your chop radius, without moving you
local Chop = { running = false, radius = 30 }

function Funcs:AutoChopNearby(Value)
	Chop.running = Value
	if not Value then return end

	task.spawn(function()
		local Trees, LastScan = {}, 0
		local Remote = ReplicatedStorage.Interaction.RemoteProxy

		while Chop.running do
			local Root, Hum = GetRoot()
			if not Root or not Hum or Hum.Health <= 0 then
				task.wait(0.5)
			else
				-- refresh the tree list every couple of seconds, not every swing
				if os.clock() - LastScan > 2 then
					LastScan = os.clock()
					Trees = {}
					for _, Region in ipairs(Funcs:GetTreeRegions()) do
						for _, Tree in ipairs(Region:GetChildren()) do
							if Tree:IsA("Model") and Tree:FindFirstChild("CutEvent") and Tree:FindFirstChild("WoodSection") then
								table.insert(Trees, Tree)
							end
						end
					end
				end

				local Cooldown = 0.5
				for _, Tree in ipairs(Trees) do
					if not Chop.running then break end

					local Section = Tree.Parent and Tree:FindFirstChild("WoodSection")
					local Class = Tree:FindFirstChild("TreeClass")
					local Owner = Tree:FindFirstChild("Owner")
					if Section and Class and Owner and (Owner.Value == nil or Owner.Value == LocalPlayer)
						and (Section.Position - Root.Position).Magnitude <= Chop.radius then

						local Axe, Stats = Funcs:GetBestAxe(Class.Value)
						if Axe and Stats then
							Cooldown = math.min(Cooldown, Stats.SwingCooldown)
							if Axe.Parent ~= LocalPlayer.Character then
								pcall(function() Hum:EquipTool(Axe) end)
							end

							local SectionId = Section:FindFirstChild("ID")
							Remote:FireServer(Tree.CutEvent, {
								tool         = Axe,
								height       = 0.3,
								faceVector   = Vector3.new(1, 0, 0),
								sectionId    = SectionId and SectionId.Value or 1,
								hitPoints    = Stats.Damage,
								cooldown     = Stats.SwingCooldown,
								cuttingClass = "Axe",
							})
						end
					end
				end
				task.wait(math.max(Cooldown, 0.1))
			end
		end
	end)
end

