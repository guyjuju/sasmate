end

local function IsNetworkOwner(Part)
	if not CanCheckOwnership() then
		return false
	end
	if not (Part and Part:IsDescendantOf(workspace)) then
		return false
	end
	local Ok, Owner = pcall(gethiddenproperty, Part, "NetworkOwnerV3")
	if Ok and Owner == LocalPlayer then
		return true
	end
	local Check = isnetworkowner or is_network_owner
	if type(Check) ~= "function" then
		return false
	end
	local Checked, Owns = pcall(Check, Part.AssemblyRootPart or Part)
	return Checked and Owns == true
end

function TakeControl(Model, Part, Timeout, KeepGoing)
	local Deadline = os.clock() + (Timeout or 6)
	local Tick = Model and Model:FindFirstChild("LastInteraction", true)
	local Baseline = Tick and Tick.Value or 0
	repeat
		if KeepGoing and not KeepGoing() then
			return false
		end
		pcall(function()
			ReplicatedStorage.Interaction.ClientIsDragging:FireServer(Model)
		end)
		if IsNetworkOwner(Part) then
			return true
		end
		Tick = Model and Model:FindFirstChild("LastInteraction", true)
		if Tick and Tick.Value > Baseline then
			return true
		end
		task.wait(0.2)
	until os.clock() > Deadline or not (Model and Model.Parent)
	return IsNetworkOwner(Part)
end

