-- Click a sawmill, then it is set to its biggest (or smallest) size
function Funcs:SetSawmillSize(Biggest)
	if ItemState.sawmilling then
		Funcs:Notify("Sawmill", "Already working on a sawmill.")
		return
	end

	Disconnect("SawmillPick")
	Funcs:Notify("Sawmill", "Click the sawmill you want to change.")

	Connections.SawmillPick = LocalPlayer:GetMouse().Button1Down:Connect(function()
		local Models = workspace:FindFirstChild("PlayerModels")
		local Target = LocalPlayer:GetMouse().Target
		if not Models or not Target then return end

		local Model = Target
		while Model and Model.Parent ~= Models do
			Model = Model.Parent
		end

		local Name = Model and Model:FindFirstChild("ItemName")
		if not Name or Name.Value:sub(1, 7) ~= "Sawmill" then return end

		Disconnect("SawmillPick")
		ItemState.sawmilling = true

		task.spawn(function()
			local Remote = ReplicatedStorage.Interaction.RemoteProxy
			local XButton = Model:FindFirstChild(Biggest and "ButtonRemote_XUp" or "ButtonRemote_XDown")
			local YButton = Model:FindFirstChild(Biggest and "ButtonRemote_YUp" or "ButtonRemote_YDown")

			if not XButton or not YButton then
				ItemState.sawmilling = false
				Funcs:Notify("Sawmill", "That sawmill has no size buttons.")
				return
			end

			for _ = 1, 20 do
				if not Model.Parent then break end
				Remote:FireServer(XButton)
				task.wait(1)
				Remote:FireServer(YButton)
				task.wait(1)
			end

			ItemState.sawmilling = false
			Funcs:Notify("Sawmill", Biggest and "Sawmill set to its biggest size." or "Sawmill set to its smallest size.")
		end)
	end)
end


