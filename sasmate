local function GetMoney()
	local Funds = ReplicatedStorage:FindFirstChild("Transactions")
	local Remote = Funds and Funds:FindFirstChild("ClientToServer")
	local Getter = Remote and Remote:FindFirstChild("GetFunds")
	if Getter then
		local Ok, Value = pcall(function()
			return Getter:InvokeServer(LocalPlayer)
		end)
		if Ok and tonumber(Value) then
			return tonumber(Value)
		end
	end
	local Stats = LocalPlayer:FindFirstChild("leaderstats")
	local Money = Stats and Stats:FindFirstChild("Money")
	return Money and Money.Value or 0
end

local function CanCheckOwnership()
	return typeof(gethiddenproperty) == "function" or typeof(isnetworkowner) == "function" or typeof(is_network_owner) == "function"
end

local function IsNetworkOwner(Part)
	if not CanCheckOwnership() then
		return false
	end
	if not (Part and Part:IsDescendantOf(workspace)) then
		return false
	end
	local Ok, Owner = pcall(gethiddenproperty, Part, "NetworkOwnerV3")
	if Ok and Owner == LocalPlayer then
		return true
	end
	local Check = isnetworkowner or is_network_owner
	if type(Check) ~= "function" then
		return false
	end
	local Checked, Owns = pcall(Check, Part.AssemblyRootPart or Part)
	return Checked and Owns == true
end

function TakeControl(Model, Part, Timeout, KeepGoing)
	-- Executors without network-owner checks (Xeno, etc.) can't confirm ownership,
	-- so just spam the drag remote with pings in between instead of waiting on a check
	if not CanCheckOwnership() then
		for _ = 1, 15 do
			if KeepGoing and not KeepGoing() then
				return false
			end
			pcall(function()
				ReplicatedStorage.Interaction.ClientIsDragging:FireServer(Model)
			end)
			pcall(function()
				local Ping = ReplicatedStorage:FindFirstChild("TestPing")
				if Ping and Ping:IsA("RemoteFunction") then Ping:InvokeServer() end
			end)
			task.wait(0.05)
		end
		return true
	end
	local Deadline = os.clock() + (Timeout or 6)
	local Tick = Model and Model:FindFirstChild("LastInteraction", true)
	local Baseline = Tick and Tick.Value or 0
	repeat
		if KeepGoing and not KeepGoing() then
			return false
		end
		pcall(function()
			ReplicatedStorage.Interaction.ClientIsDragging:FireServer(Model)
		end)
		if IsNetworkOwner(Part) then
			return true
		end
		Tick = Model and Model:FindFirstChild("LastInteraction", true)
		if Tick and Tick.Value > Baseline then
			return true
		end
		task.wait(0.2)
	until os.clock() > Deadline or not (Model and Model.Parent)
	return IsNetworkOwner(Part)
end

