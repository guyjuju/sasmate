		end
	end)
end

local function AcquireNetworkOwnership(Target, Sections, Timeout)
	local Targets = Target
	if typeof(Targets) == "Instance" then
		Targets = { Targets }
	end
	local Deadline = os.clock() + (Timeout or 30)
	local Initial = {}
	for _, Item in ipairs(Targets) do
		local Last = Item:FindFirstChild("LastInteraction", true)
		Initial[Item] = Last and Last.Value
	end
	repeat
		local AllOwned = true
		for _, Item in ipairs(Targets) do
			if not Item.Parent then
				return false, "Target no longer exists"
			end
			local Parts = Sections or { Item.PrimaryPart or Item:FindFirstChildWhichIsA("BasePart", true) or Item }
			local Owned = true
			for _, Part in ipairs(Parts) do
				if Part.Parent and not IsNetworkOwner(Part) then
					Owned = false
					break
				end
			end
			if (not Owned or not CanCheckOwnership()) and not Sections then
				local Last = Item:FindFirstChild("LastInteraction", true)
				Owned = Last ~= nil and Initial[Item] ~= nil and Last.Value > Initial[Item]
			end
			if not Owned then
				AllOwned = false
				Drag(Item)
			end
		end
		if AllOwned then
			RoundTrip()
			return true
		end
		task.wait()
	until Buy.abort or os.clock() > Deadline
	return false, "Ownership timed out"
end

local function CashierFile()
	local Server = (game.JobId ~= "" and game.JobId) or tostring(game.PlaceId)
	return "SasMate/cashierIds_" .. Server .. ".json", Server
end

local function LoadCashierIds()
	if typeof(readfile) ~= "function" then return end
	local File, Server = CashierFile()
	local Ok, Data = pcall(readfile, File)
	if not Ok or type(Data) ~= "string" then return end
	local Ok2, Saved = pcall(function()
		return game:GetService("HttpService"):JSONDecode(Data)
	end)
	if Ok2 and type(Saved) == "table" and Saved.server == Server and type(Saved.ids) == "table" then
		for Name, Id in pairs(Saved.ids) do
			if CashierIds[Name] == nil and tonumber(Id) then
				CashierIds[Name] = tonumber(Id)
			end
		end
	end
end

local function SaveCashierIds()
	if typeof(writefile) ~= "function" then return end
	if typeof(makefolder) == "function" then
		pcall(makefolder, "SasMate")
	end
	local File, Server = CashierFile()
	pcall(writefile, File, game:GetService("HttpService"):JSONEncode({ server = Server, ids = CashierIds }))
end

local function RecordCashierIds(...)
	for _, Payload in ipairs({ ... }) do
		local Id = typeof(Payload) == "table" and tonumber(Payload.ID)
		local Name = Id and Payload.Name
		if typeof(Name) == "Instance" then
			Name = Name.Name
		end
		if Id and type(Name) == "string" and CashierIds[Name] ~= Id then
			CashierIds[Name] = Id
			SaveCashierIds()
		end
	end
end

local function HookCashierIds()
	local Folder = ReplicatedStorage:FindFirstChild("NPCDialog")
	local Prompt = Folder and Folder:FindFirstChild("PromptChat")
	if not Prompt then return end
	Prompt.OnClientEvent:Connect(function(...)
		RecordCashierIds(...)
	end)
end

local function SetChatting(Value)
	local Folder = ReplicatedStorage:FindFirstChild("NPCDialog")
	local Remote = Folder and Folder:FindFirstChild("SetChattingValue")
	if not Remote then return false end
	if Remote:IsA("RemoteEvent") then
		pcall(function() Remote:FireServer(Value) end)
		return true
	elseif Remote:IsA("RemoteFunction") then
		pcall(function() Remote:InvokeServer(Value) end)
		return true
	end
	return false
end

local function FetchCashierId(CashierName)
	if CashierIds[CashierName] then return true end
	local Started, LastToggle = os.clock(), 0
	repeat
		if os.clock() - LastToggle >= CashierTimeouts.toggleGap then
			LastToggle = os.clock()
			SetChatting(0)
			task.wait(0.2)
			SetChatting(1)
		end
		task.wait(0.1)
	until CashierIds[CashierName] or os.clock() - Started > CashierTimeouts.collect
	SetChatting(0)
	if not CashierIds[CashierName] then
		return false
	end
	return true
end

local function AskForCashierId(Npc)
	local Head = Npc and (Npc:FindFirstChild("Head") or Npc.PrimaryPart)
	if not Head then
		return Npc and Npc.Name .. " has no head to stand next to" or "no keeper"
	end
	for _ = 1, CashierTimeouts.attempts do
		if CashierIds[Npc.Name] then break end
		Funcs:TeleportTo(CFrame.new(Head.Position + Vector3.new(4, 3, 4)))
		task.wait(0.3)
		FetchCashierId(Npc.Name)
		SetChatting(1)
	end
	return nil
end

