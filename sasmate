	sellPlank = false,
}

-- Waits for you to click something. Resolve(Target) returns the thing you picked, or nil
local function WaitForClick(Resolve, Timeout)
	local Mouse = LocalPlayer:GetMouse()
	local Result

	local Click = Mouse.Button1Down:Connect(function()
		local Target = Mouse.Target
		if Target then
			Result = Resolve(Target) or Result
		end
	end)

	local Started = os.clock()
	while not Result and Mod.busy and os.clock() - Started < (Timeout or 60) do
		task.wait()
	end

	Click:Disconnect()
	return Result
end

-- Click any part of a sawmill (it needs the size settings the game puts on sawmills)
local function ResolveSawmill(Target)
	local Part = Target.Parent
	if not Part then return nil end

	local Settings = Part:FindFirstChild("Settings")
	local Dim = Settings and Settings:FindFirstChild("DimZ")

	if not Dim and Part.Parent then
		Settings = Part.Parent:FindFirstChild("Settings")
		Dim = Settings and Settings:FindFirstChild("DimZ")
	end

	return Dim and Dim.Parent.Parent or nil
end

-- Click a cut log that is yours (or free)
local function ResolveLog(Target)
	local Model = Target.Parent
	if Model and Model.Parent == workspace.LogModels and Model:FindFirstChild("WoodSection") then
		local Owner = Model:FindFirstChild("Owner")
		if Owner and (Owner.Value == LocalPlayer or Owner.Value == nil) then
			return Model
		end
	end
	return nil
end

-- The lava pit at the volcano
local function GetLava()
	local Region = workspace:FindFirstChild("Region_Volcano")
	if not Region then return nil end

	local Wanted = Vector3.new(-1675.2002, 255.002533, 1284.19983)
	local Fallback

	for _, Child in ipairs(Region:GetChildren()) do
		local Lava = Child:FindFirstChild("Lava")
		if Lava and Lava:IsA("BasePart") then
			Fallback = Fallback or Lava
			if (Lava.Position - Wanted).Magnitude < 1 then
				return Lava
			end
		end
	end
	return Fallback
end

local function Alive()
	local Root, Hum = GetRoot()
	if not Root or not Hum or Hum.Health <= 0 then
		error("you died", 0)
	end
end

local function IsWoodSection(Obj)
	return Obj:IsA("BasePart") and Obj.Name:find("WoodSection") ~= nil
end

-- Swings at the log's lowest section (same cut Auto Bring Wood uses)
function Funcs:ModChop(Log, Axe, Stats)
	local CutEvent = Log:FindFirstChild("CutEvent")
	local Lowest = math.huge

	for _, Section in ipairs(Log:GetChildren()) do
		if IsWoodSection(Section) then
			local ID = Section:FindFirstChild("ID")
			if ID and ID.Value < Lowest then
				Lowest = ID.Value
			end
		end
	end

	if not CutEvent or Lowest == math.huge then return end

	ReplicatedStorage.Interaction.RemoteProxy:FireServer(CutEvent, {
		tool         = Axe,
		faceVector   = Vector3.new(1, 0, 0),
		height       = 0.3,
		sectionId    = Lowest,
		hitPoints    = Stats.Damage,
		cooldown     = 0.1,
		cuttingClass = "Axe",
	})
end

-- Sends a plank to the Wood Drop Off and brings you back
local function SellPlank(Plank, Home)
	local Owner = Plank:WaitForChild("Owner", 10)
	local Started = os.clock()
	while Owner and Owner.Value == nil and os.clock() - Started < 10 do
		task.wait()
	end
	if not Owner or Owner.Value ~= LocalPlayer then return end

	local Part = Plank:FindFirstChild("WoodSection") or Plank:FindFirstChildWhichIsA("BasePart", true)
	if not Part then return end

	Funcs:TeleportTo(CFrame.new(Part.Position + Vector3.new(0, 5, 0)))
	TakeControl(Plank, Part, 6)

	local Spot = CFrame.new(315, 3, 85) * CFrame.Angles(math.rad(-90), 0, 0)
	for _ = 1, 25 do
		if not Plank.Parent then break end
		Drag(Plank)
		Plank:PivotTo(Spot)
		task.wait()
	end

	Funcs:TeleportTo(Home)
end

-- Mod Wood: click a sawmill, then a log. The log is split so a thin piece goes into the sawmill
function Funcs:ModWood()
	if Mod.busy then
		Funcs:Notify("Mod Wood", "You're already using this feature.")
		return
	end

	if typeof(firetouchinterest) ~= "function" then
		Funcs:Notify("Mod Wood", "Your executor doesn't support firetouchinterest.")
		return
	end

	if not GetRoot() then
		Funcs:Notify("Mod Wood", "Character isn't loaded.")
		return
	end

	if not Funcs:GetBestAxe("Generic") then
		Funcs:Notify("Mod Wood", "You need an axe to use this feature.")
		return
	end

	Mod.busy = true

	task.spawn(function()
		local Root = GetRoot()
		local Home = Root.CFrame
		local WasFlying = Flight.active
		local Done = false

		local Ok, Err = pcall(function()
			Funcs:Notify("Mod Wood", "Click the sawmill you want to use.")
			local Sawmill = WaitForClick(ResolveSawmill)
			if not Sawmill then error("nothing was selected", 0) end
			Funcs:Notify("Mod Wood", "Sawmill selected. Now click the log you want to mod.")

			local Log = WaitForClick(ResolveLog)
			if not Log then error("nothing was selected", 0) end

			local Particles = Sawmill:FindFirstChild("Particles")
			if not Particles then error("that sawmill has no Particles part", 0) end

			local Class = Log:FindFirstChild("TreeClass")
			local TreeClass = Class and Class.Value or "Generic"
			local IsPine = TreeClass == "Pine" or TreeClass == "Fir"

			local Axe, Stats = Funcs:EnsureBestAxe(TreeClass)
			if not Axe then error("you need an axe to use this feature", 0) end

			-- Find the thin piece that goes into the sawmill, the piece it hangs off, and the base
			local Sections = Log:GetDescendants()
			local Smallest, Size = nil, math.huge

			for _, Obj in ipairs(Sections) do
				if IsWoodSection(Obj) then
					if IsPine then
						if Obj.Size.X <= Size and Obj.Size.X >= 0.5 then
							Size = Obj.Size.X
							Smallest = Obj
						end
					else
						local ID = Obj:FindFirstChild("ID")
						if ID and ID.Value >= 3 and Obj:FindFirstChild("ParentID") then
							Size = Obj.Size.X
							Smallest = Obj
						end
					end
				end
			end

			if not Smallest or not Smallest:FindFirstChild("ParentID") then
				error("this tree can't be modded", 0)
			end

			local SellPiece, Base
			for _, Obj in ipairs(Sections) do
				if IsWoodSection(Obj) then
					local ID = Obj:FindFirstChild("ID")
					if ID and ID.Value == Smallest.ParentID.Value and Obj.Parent == Smallest.Parent then
						SellPiece = Obj
					end
					if ID and ID.Value == 1 then
						Base = Obj
					end
				end
			end

			if not SellPiece or not Base then
				error("this tree can't be modded", 0)
			end

			local Lava = GetLava()
			if not Lava then error("couldn't find the lava", 0) end

			-- Stay in the air while we move around
			if not Flight.active then
				Funcs:StartFlight()
			end

			Log.PrimaryPart = SellPiece

			-- Go to the log and take control of it
			local Started = os.clock()
			while (GetRoot().Position - Base.Position).Magnitude > 10 and os.clock() - Started < 10 do
				Alive()
				Funcs:TeleportTo(CFrame.new(Base.Position + Vector3.new(0, 5, 0)))
				task.wait()
			end

			TakeControl(Log, Base, 8)
			Funcs:TeleportTo(Base.CFrame)

			-- Burn the log, then drop the fire
			local Burnt = false
			for _ = 1, 60 do
				Alive()
				for _ = 1, 6 do
					Drag(Log)
					Log:PivotTo(CFrame.new(-1425, 489, 1244))
					if Log.PrimaryPart then
						Log.PrimaryPart.AssemblyLinearVelocity = Vector3.zero
						Log.PrimaryPart.AssemblyAngularVelocity = Vector3.zero
					end
					task.wait()
				end

				firetouchinterest(Log.PrimaryPart, Lava, 0)
				firetouchinterest(Log.PrimaryPart, Lava, 1)

				if Log.PrimaryPart:FindFirstChild("LavaFire") then
					Burnt = true
					break
				end
			end

			if not Burnt then error("couldn't set the log on fire", 0) end
			Log.PrimaryPart:FindFirstChild("LavaFire"):Destroy()

			for _ = 1, 8 do
				Drag(Log)
				Log:PivotTo(CFrame.new(-1055, 291, -458))
				task.wait()
			end
			Funcs:TeleportTo(CFrame.new(-1055, 291, -458))

			-- Sell the piece that was holding the thin one
			local Sold = false
			SellPiece.AncestryChanged:Connect(function()
				Sold = true
			end)

			task.spawn(function()
				while not Sold and Mod.busy do
					for _ = 1, 10 do
						task.wait()
						SellPiece.CFrame = CFrame.new(315, 0, 85)
						Drag(Log)
					end
				end
			end)

			Started = os.clock()
			while not Sold and os.clock() - Started < 45 do
				Alive()
				task.wait()
			end
			if not Sold then error("the log piece never sold", 0) end

			-- Take control of what is left and walk it into the sawmill
			Funcs:TeleportTo(Smallest.CFrame)

			for _, Obj in ipairs(Sections) do
				if IsWoodSection(Obj) and Obj ~= Smallest and Obj:IsDescendantOf(Log) then
					Log.PrimaryPart = Obj
				end
			end

			task.spawn(function()
				TakeControl(Log, Smallest, 8)

				for _ = 1, 10 do
					if not Sawmill:IsDescendantOf(workspace.PlayerModels) then break end
					task.wait()
					Smallest.CFrame = Particles.CFrame + Vector3.new(0, 0.5, 0)
					Drag(Log)
				end
			end)

			if not Sawmill:IsDescendantOf(workspace.PlayerModels) then
				error("the sawmill is gone. Did you reload?", 0)
			end

			Funcs:TeleportTo(CFrame.new(Log.PrimaryPart.Position + Vector3.new(0, 5, 4)))

			-- Done once a new log of yours appears
			local Modded = false
			local Watch = workspace.LogModels.ChildAdded:Connect(function(New)
				local Owner = New:WaitForChild("Owner", 10)
				if Owner and Owner.Value == LocalPlayer then
					Modded = true
				end
			end)

			local PlankWatch
			if Mod.sellPlank then
				PlankWatch = workspace.PlayerModels.ChildAdded:Connect(function(Plank)
					if Plank.Name:match("Plank") then
						if PlankWatch then PlankWatch:Disconnect() end
						task.spawn(SellPlank, Plank, Home)
					end
				end)

				task.delay(90, function()
					if PlankWatch then PlankWatch:Disconnect() end
				end)
			end

			-- Keep cutting and pushing the thin piece into the sawmill
			local Threshold = 0
			Started = os.clock()
			repeat
				Alive()
				local Main = Log:FindFirstChild("WoodSection")
				if not Main then break end

				Funcs:TeleportTo(CFrame.new(Main.Position + Vector3.new(0, 0, 5)))
				Funcs:ModChop(Log, Axe, Stats)

				for _ = 1, 12 do
					task.wait()
					Smallest.CFrame = Particles.CFrame
					Drag(Log)

					if (Smallest.Position - Particles.Position).Magnitude <= 10 then
						Threshold = Threshold + 1
						if Threshold >= 45 then break end
					end
				end
			until Modded or os.clock() - Started > 90

			Watch:Disconnect()
			Done = Modded
		end)

		Mod.busy = false

		if not WasFlying then
			Funcs:StopFlight()
		end

		if not (Mod.sellPlank and Ok and Done) then
			Funcs:TeleportTo(Home)
		end

		if not Ok then
			Funcs:Notify("Mod Wood", "Stopped: " .. tostring(Err))
		elseif Done then
			Funcs:Notify("Mod Wood", "Modded!")
		else
			Funcs:Notify("Mod Wood", "It didn't finish. Try again.")
		end
	end)
end

-- Mod Sawmill: click a sawmill and four floor blueprints are placed along its conveyor.
-- Fill them with wood to finish the mod
function Funcs:ModSawmill()
	if Mod.busy then
		Funcs:Notify("Mod Sawmill", "You're already using this feature.")
		return
	end

	Mod.busy = true

	task.spawn(function()
		local Ok, Err = pcall(function()
			Funcs:Notify("Mod Sawmill", "Click the sawmill you want to mod.")
			local Sawmill = WaitForClick(ResolveSawmill)
			if not Sawmill then error("nothing was selected", 0) end

			local Conveyor = Sawmill:FindFirstChild("Conveyor")
			local Pieces = Conveyor and Conveyor:FindFirstChild("Model") and Conveyor.Model:GetChildren()
			local Name = Sawmill:FindFirstChild("ItemName")
			local Main = Sawmill:FindFirstChild("Main")
			if not Pieces or #Pieces == 0 or not Name or not Main then
				error("that sawmill can't be modded", 0)
			end

			local Piece = Pieces[(Name.Value:match("Sawmill4L") and #Pieces - 1) or #Pieces]
			if not Piece then error("that sawmill can't be modded", 0) end

			local Orientation = Main.Orientation.Y
			local Sideways = Orientation == 0 or Orientation == 180
			local Offset = 0.4

			for _ = 1, 4 do
				Offset = Offset + 0.2

				local Shift = Vector3.new(
					(Orientation == 0 and -Offset) or (Orientation == 180 and Offset) or 0,
					1.5,
					(Orientation == -90 and -Offset) or (Orientation == 90 and Offset) or 0
				)

				local Turn = CFrame.Angles(
					math.rad(Sideways and 90 or 45),
					math.rad(Sideways and 0 or 90),
					math.rad(Sideways and 90 or 45)
				)

				ReplicatedStorage.PlaceStructure.ClientPlacedBlueprint:FireServer("Floor2", CFrame.new(Piece.Position + Shift) * Turn, LocalPlayer)
				task.wait(1.5)
			end

			Funcs:Notify("Mod Sawmill", "Fill the blueprints to finish the mod.")
		end)

		Mod.busy = false

		if not Ok then
			Funcs:Notify("Mod Sawmill", "Stopped: " .. tostring(Err))
		end
	end)
end

-- Sets a sawmill to its biggest (Maximum) or smallest size
function Funcs:SawmillResize(Type)
	if Mod.busy then
		Funcs:Notify("Sawmill", "You're already using this feature.")
		return
	end

	Mod.busy = true

	task.spawn(function()
		local Ok, Err = pcall(function()
			Funcs:Notify("Sawmill", "Click the sawmill you want to resize.")
			local Sawmill = WaitForClick(ResolveSawmill)
			if not Sawmill then error("nothing was selected", 0) end

			local Name = Sawmill:FindFirstChild("ItemName")
			local Info = Name and ReplicatedStorage.ClientItemInfo:FindFirstChild(Name.Value)
			local Limit = Info and Info:FindFirstChild("OtherInfo") and Info.OtherInfo:FindFirstChild("MaxOutputSize")
			local Settings = Sawmill:FindFirstChild("Settings")
			if not Limit or not Settings then error("that sawmill can't be resized", 0) end

			local Biggest = Type == "Maximum"
			local XSize = Biggest and tonumber(string.format("%.1f", Limit.Value.X)) or 0.6
			local ZSize = Biggest and tonumber(string.format("%.1f", Limit.Value.Z)) or 0.4

			local XButton = Sawmill:FindFirstChild(Biggest and "ButtonRemote_XUp" or "ButtonRemote_XDown")
			local YButton = Sawmill:FindFirstChild(Biggest and "ButtonRemote_YUp" or "ButtonRemote_YDown")
			local DimX, DimZ = Settings:FindFirstChild("DimX"), Settings:FindFirstChild("DimZ")
			if not XButton or not YButton or not DimX or not DimZ then
				error("that sawmill has no size buttons", 0)
			end

			local Remote = ReplicatedStorage.Interaction.RemoteProxy
			local Started = os.clock()

			local function Round(Value)
				return tonumber(string.format("%.1f", Value))
			end

			-- Press each size button until that size is reached (or 60 seconds pass)
			while (Round(DimX.Value) ~= XSize or Round(DimZ.Value) ~= ZSize)
				and Sawmill.Parent and os.clock() - Started < 60 do
				if Round(DimX.Value) ~= XSize then
					Remote:FireServer(XButton)
				end
				if Round(DimZ.Value) ~= ZSize then
					Remote:FireServer(YButton)
				end
				task.wait()
			end

			if Round(DimX.Value) ~= XSize or Round(DimZ.Value) ~= ZSize then
				error("it didn't reach that size", 0)
			end

			Funcs:Notify("Sawmill", Biggest and "Sawmill set to its biggest size." or "Sawmill set to its smallest size.")
		end)

		Mod.busy = false

		if not Ok then
			Funcs:Notify("Sawmill", "Stopped: " .. tostring(Err))
		end
	end)
end


