-- Store ids used by the shop NPCs (keyed by the store model's name)
local ShopIds = {
	WoodRUs        = 7,
	CarStore       = 9,
	FurnitureStore = 8,
	ShackShop      = 10,
	LogicStore     = 12,
	FineArt        = 11,
}

-- Auto Buy runtime state
local Buy = {
	running = false,
	abort   = false,
	item    = nil, -- selected dropdown label
	amount  = 1,
	debug   = true, -- step-by-step notifications (toggle in the Auto Buy tab)
	items   = {},  -- ["Item - $Price"] = { Box = "BoxItemName", Price = number }
}

local function GetMoney()
	local Stats = LocalPlayer:FindFirstChild("leaderstats")
	local Money = Stats and Stats:FindFirstChild("Money")
	return Money and Money.Value or 0
end

local function Debug(Message)
	if Buy.debug then
		Funcs:Notify("Auto Buy", Message)
	end
end

-- Every non-blueprint item currently sitting in the shops, as "Name - $Price"
function Funcs:GetShopItems()
	local Names = {}
	Buy.items = {}

	local Info = ReplicatedStorage:FindFirstChild("ClientItemInfo")
	local Stores = workspace:FindFirstChild("Stores")
	if not Info or not Stores then return Names end

	for _, Store in ipairs(Stores:GetChildren()) do
		if Store:IsA("Model") and Store.Name == "ShopItems" then
			for _, Box in ipairs(Store:GetChildren()) do
				local Type = Box:FindFirstChild("Type")
				local BoxName = Box:FindFirstChild("BoxItemName")
				local Item = BoxName and Info:FindFirstChild(BoxName.Value)

				if Type and Type.Value ~= "Blueprint" and Item
					and Item:FindFirstChild("ItemName") and Item:FindFirstChild("Price") then
					local Label = Item.ItemName.Value .. " - $" .. Item.Price.Value
					if not Buy.items[Label] then
						Buy.items[Label] = { Box = Item.Name, Price = Item.Price.Value }
						table.insert(Names, Label)
					end
				end
			end
		end
	end

	table.sort(Names)
	return Names
end

-- The shop counter closest to you
function Funcs:GetStoreCounter()
	local Char = LocalPlayer.Character
	local Head = Char and Char:FindFirstChild("Head")
	local Stores = workspace:FindFirstChild("Stores")
	if not Head or not Stores then return nil end

	local Best, BestDist
	for _, Store in ipairs(Stores:GetChildren()) do
		if Store:IsA("Model") and Store.Name ~= "ShopItems" then
			local Counter = Store:FindFirstChild("Counter")
			if Counter then
				local Dist = (Head.Position - Counter.Position).Magnitude
				if not BestDist or Dist < BestDist then
					Best, BestDist = Counter, Dist
				end
			end
		end
	end
	return Best
end

-- Waits (up to Timeout seconds) for an unowned shop box with this BoxItemName
function Funcs:FindShopBox(BoxName, Timeout)
	local Started = os.clock()
	repeat
		local Stores = workspace:FindFirstChild("Stores")
		if Stores then
			for _, Store in ipairs(Stores:GetChildren()) do
				if Store:IsA("Model") and Store.Name == "ShopItems" then
					for _, Box in ipairs(Store:GetChildren()) do
						local Owner = Box:FindFirstChild("Owner")
						local Name = Box:FindFirstChild("BoxItemName")
						if Owner and Owner.Value == nil and Name and tostring(Name.Value) == BoxName then
							return Box
						end
					end
				end
			end
		end
		task.wait()
	until Buy.abort or os.clock() - Started > (Timeout or 10)
	return nil
end

-- Finds the shop clerk standing at this counter
function Funcs:GetStoreNpc(Counter)
	local Best, BestDist
	for _, Obj in ipairs(Counter.Parent:GetDescendants()) do
		if Obj:IsA("Humanoid") and Obj.Parent:IsA("Model") then
			local Part = Obj.Parent:FindFirstChild("HumanoidRootPart") or Obj.Parent:FindFirstChild("Head")
			if Part then
				local Dist = (Part.Position - Counter.Position).Magnitude
				if not BestDist or Dist < BestDist then
					Best, BestDist = Obj.Parent, Dist
				end
			end
		end
	end
	return Best
end

-- Talks to a shop NPC: Response is "Initiate" to start the chat, "ConfirmPurchase" to buy
function Funcs:TalkToNpc(Id, Npc, Response)
	local Remote = ReplicatedStorage.NPCDialog.PlayerChatted
	local Dialog = { ID = Id, Character = Npc, Name = Npc and Npc.Name }

	return pcall(function()
		return Remote:InvokeServer(Dialog, Response)
	end)
end

-- Buys ONE box: walks to it, puts it on the counter, talks to the clerk,
-- confirms the purchase, then either opens it (blueprints) or drops it at Home
function Funcs:BuyBox(BoxName, OpenBox, Home)
	local Box = Funcs:FindShopBox(BoxName, 10)
	if not Box then return false, "Couldn't find " .. BoxName .. " in the shop." end

	local Main = Box:FindFirstChild("Main")
	local Root = GetRoot()
	if not Main or not Root then return false, "Character isn't loaded." end

	Debug("Found " .. BoxName .. ".")

	if (Root.Position - Main.Position).Magnitude > 25 then
		Funcs:TeleportTo(CFrame.new(Main.Position + Vector3.new(5, 1, 5)))
		task.wait(0.2)
	end

	local Counter = Funcs:GetStoreCounter()
	local StoreId = Counter and ShopIds[Counter.Parent.Name]
	if not StoreId then
		return false, "Couldn't find the store counter" .. (Counter and (" (unknown store " .. Counter.Parent.Name .. ").") or ".")
	end

	-- Stand next to the counter so the clerk can hear you
	Root = GetRoot()
	if Root and (Root.Position - Counter.Position).Magnitude > 12 then
		Funcs:TeleportTo(CFrame.new(Counter.Position + Vector3.new(5, 3, 5)))
		task.wait(0.2)
	end

	local Drag = ReplicatedStorage.Interaction.ClientIsDragging

	-- Put the item on the counter
	for _ = 1, 25 do
		Drag:FireServer(Box)
		Box:PivotTo(Counter.CFrame + Vector3.new(0, Counter.Size.Y / 2 + Main.Size.Y / 2 + 0.5, 0))
		task.wait()
	end
	Debug("Item is on the counter.")

	-- Talk to the clerk first, then confirm
	local Npc = Funcs:GetStoreNpc(Counter)
	Debug("Talking to " .. (Npc and Npc.Name or "the clerk") .. " (store " .. StoreId .. ").")
	local InitOk, InitResult = Funcs:TalkToNpc(StoreId, Npc, "Initiate")
	Debug("Initiate -> " .. tostring(InitOk) .. ", " .. tostring(InitResult))
	task.wait(0.5)

	-- Confirm the purchase until the box leaves the shop
	local Logged = false
	local Started = os.clock()
	repeat
		Drag:FireServer(Box)
		task.spawn(function()
			local Ok, Result = Funcs:TalkToNpc(StoreId, Npc, "ConfirmPurchase")
			if not Logged then
				Logged = true
				Debug("ConfirmPurchase -> " .. tostring(Ok) .. ", " .. tostring(Result))
			end
		end)
		task.wait(0.1)
	until Buy.abort or not Box.Parent or Box.Parent.Name ~= "ShopItems" or os.clock() - Started > 15

	if Buy.abort then return false, "Aborted." end
	if Box.Parent and Box.Parent.Name == "ShopItems" then
		return false, "The clerk didn't accept the purchase (turn on Debug Messages to see why)."
	end
	Debug("Purchased.")

	if OpenBox then
		local Opened = os.clock()
		while Box.Parent and not Buy.abort and os.clock() - Opened < 10 do
			ReplicatedStorage.Interaction.ClientInteracted:FireServer(Box, "Open box")
			task.wait(1)
		end
	else
		for _ = 1, 25 do
			Drag:FireServer(Box)
			Box:PivotTo(Home + Vector3.new(5, 1, 0))
			task.wait()
		end
	end

	return true
end

-- Buys the selected shop item Amount times, then takes you back
function Funcs:AutoBuy(Label, Amount)
	if type(Label) == "table" then Label = Label[1] end

	if Buy.running then
		Funcs:Notify("Auto Buy", "Already buying. Press Abort first.")
		return
	end

	local Entry = Label and Buy.items[Label]
	if not Entry then
		Funcs:Notify("Auto Buy", "Pick an item first.")
		return
	end

	if GetMoney() < Entry.Price * Amount then
		Funcs:Notify("Auto Buy", "You can't afford " .. Amount .. "x " .. Label .. ".")
		return
	end

	local Root = GetRoot()
	if not Root then
		Funcs:Notify("Auto Buy", "Character isn't loaded.")
		return
	end

	Buy.running, Buy.abort = true, false
	local Home = Root.CFrame

	task.spawn(function()
		local Done, Failure = 0, nil

		for _ = 1, Amount do
			if Buy.abort then break end

			local Ok, Success, Msg = pcall(Funcs.BuyBox, Funcs, Entry.Box, false, Home)
			if not Ok then
				Success, Msg = false, tostring(Success)
			end

			if not Success then
				Failure = Msg
				break
			end

			Done = Done + 1
			task.wait(0.3)
		end

		local Aborted = Buy.abort
		Buy.running = false
		Funcs:TeleportTo(Home)

		if Failure and not Aborted then
			Funcs:Notify("Auto Buy", Done .. "/" .. Amount .. " bought. " .. Failure)
		elseif Aborted then
			Funcs:Notify("Auto Buy", "Stopped after " .. Done .. "/" .. Amount .. ".")
		else
			Funcs:Notify("Auto Buy", "Bought " .. Done .. "x " .. Label .. ".")
		end
	end)
end

function Funcs:AbortBuying()
