-- MARK: Credits Tab
--
-- Close Script: stops everything and removes the menu
function Funcs:CloseScript()
	local function Try(Fn, ...)
		pcall(Fn, ...)
	end

	-- every loop and feature
	Wood.active = nil
	Buy.abort = true
	ItemState.abort = true
	Claim.running = false
	Chop.running = false
	AO.Running = false

	Try(Funcs.StopFlight, Funcs)
	Try(Funcs.StopStackPicking, Funcs)
	Try(Funcs.ClearGroupSelect, Funcs)
	Try(Funcs.FlyButton, Funcs, false)
	Try(Funcs.MobileToggle, Funcs, false)
	Try(Funcs.Spin, Funcs, false)
	Try(Funcs.LayDown, Funcs, false)
	Try(Funcs.FakeLag, Funcs, false)
	Try(Funcs.JumpSpam, Funcs, false)
	Try(Funcs.Headless, Funcs, false)

	-- every connection the script made
	local function Kill(Item)
		if typeof(Item) == "RBXScriptConnection" then
			Item:Disconnect()
		elseif type(Item) == "table" then
			for _, Inner in pairs(Item) do
				Kill(Inner)
			end
		end
	end
	for Key, Item in pairs(Connections) do
		Try(Kill, Item)
		Connections[Key] = nil
	end
	for Key, Item in pairs(Troll.Conns) do
		Try(Kill, Item)
		Troll.Conns[Key] = nil
	end

	-- put your character back to normal
	local Root, Hum = GetRoot()
	if Root then Root.Anchored = false end
	if Hum then
		Hum.PlatformStand = false
		Hum.WalkSpeed = 16
		Hum.JumpPower = 50
	end

	Try(function()
		local Preview = workspace:FindFirstChild("SasMateStackPreview")
		if Preview then Preview:Destroy() end
	end)

	Funcs:Notify("Sas Mate", "Script closed")

	-- last: remove the menu itself
	task.defer(function()
		local ScreenGui = game.CoreGui:FindFirstChild("SasMate")
		if ScreenGui then ScreenGui:Destroy() end
		local Abort = game.CoreGui:FindFirstChild("SasMateAbortStack")
		if Abort then Abort:Destroy() end
	end)
end

